---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="featured-card" id={project.slug}>
  <header class="featured-head">
    <div class="featured-title-row">
      <h3 class="featured-name">{project.name}</h3>
      <span
        class:list={[
          "visibility-badge",
          project.visibility === "proprietary"
            ? "visibility-badge--proprietary"
            : "visibility-badge--public",
        ]}
      >
        {project.visibility === "proprietary" ? "Private · Proprietary" : "Open Source"}
      </span>
    </div>
    <p class="featured-tagline">{project.tagline}</p>
  </header>

  <p class="featured-desc">{project.description}</p>

  <!-- Compact inline metadata chips (Stack / Domain / License) -->
  <ul class="featured-chips">
    {
      project.meta.map((meta) => (
        <li class="chip">
          <span class="chip-label">{meta.label}</span>
          <span class="chip-value">{meta.value}</span>
        </li>
      ))
    }
  </ul>

  {
    project.links.length > 0 ? (
      <div class="featured-links">
        {project.links.map((link) => (
          <a
            href={link.href}
            class="btn btn--primary"
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.label} <span aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="featured-private-note">
        Private repository — source code and internal details are not publicly distributed.
      </p>
    )
  }
</article>

<style>
  .featured-card {
    position: relative;
    z-index: 1; /* above the SpectralNetwork background (z-index: 0) */
    display: flex;
    flex-direction: column;
    gap: 0.9em;
    padding: 1.5em 1.6em;
    background: rgba(40, 39, 39, 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    box-shadow: 0 0 30px rgba(101, 133, 148, 0.06);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .featured-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
  }

  .featured-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .visibility-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2em 0.65em;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  .visibility-badge--public {
    color: var(--color-accent);
    background: rgba(127, 160, 175, 0.08);
  }

  .visibility-badge--proprietary {
    color: var(--color-heading);
    background: rgba(196, 178, 138, 0.08);
  }

  .featured-head h3 {
    margin: 0;
    font-size: 1.3rem;
    color: var(--color-heading);
  }

  .featured-tagline {
    margin: 0.25em 0 0;
    font-size: 0.88rem;
    color: var(--color-accent);
    line-height: 1.5;
  }

  .featured-desc {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .featured-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45em;
    margin: 0;
    padding: 0;
  }

  .featured-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8em;
    margin-top: 0.4em;
  }

  .featured-private-note {
    margin: 0.2em 0 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-sidebar-muted);
  }
</style>
