---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactLinks, domains, featuredProjects } from "../data/projects";

const outcomes = [
  {
    label: "In-house trace-element testing",
    detail: "I validated methods so the lab could run trace-element tests it had been sending out.",
    context: "TMC Manufacturing",
  },
  {
    label: "Capital proposal and commissioning",
    detail:
      "I wrote a capital proposal of more than $500,000 for ion chromatography and ICP-MS. I worked with the vendor to commission the ICP-MS.",
    context: "TMC Manufacturing",
  },
  {
    label: "Testing for stable-isotope production",
    detail:
      "I developed trace-element methods to support production against a ≥99.999% product purity specification.",
    context: "TMC Manufacturing",
  },
  {
    label: "Processing more than 9,500 MS/MS spectra",
    detail:
      "I developed a Python workflow to process untargeted LC-MS/MS data from botanical, fungal, and pharmaceutical samples and generate candidate annotations.",
    context: "Delic Labs",
  },
];

const email = contactLinks.find((link) => link.label === "Email")!;
const linkedIn = contactLinks.find((link) => link.label === "LinkedIn")!;
const softwareScope: Record<string, string> = {
  massflow:
    "Searches local MS/MS libraries, ranks candidates by spectral similarity, and records how each file was processed.",
  msmcp:
    "Lets MCP clients run mass spectrometry checks, compare spectra, and search libraries using local data.",
  masspilot: "Helps scientists inspect the evidence behind LC-HRMS annotations.",
};
---

<BaseLayout
  title="Eric Janusson, PhD | Analytical Chemistry & Mass Spectrometry"
  description="Eric Janusson, PhD. Mass spectrometry, analytical method development and validation, and scientific Python."
>
  <div class="portfolio">
    <header class="hero">
      <div>
        <p class="label">British Columbia, Canada</p>
        <h1>Eric Janusson<span>, PhD</span></h1>
        <p class="specialty">Analytical chemist and mass spectrometrist</p>
        <p class="intro">
          I develop and validate analytical methods and write software for mass spectrometry data.
        </p>
        <div class="actions">
          <a href={email.href} class="btn btn--primary"
            >Email Eric <span aria-hidden="true">↗</span></a
          >
          <a href="#measurement">See my laboratory work <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <img
        class="portrait"
        src="/assets/images/eric-janusson.jpg"
        alt="Portrait of Eric Janusson"
        width="512"
        height="512"
        fetchpriority="high"
      />
    </header>

    <section class="band" id="measurement" aria-labelledby="outcomes-heading">
      <h2 id="outcomes-heading">Selected laboratory work</h2>
      <div class="outcomes">
        {
          outcomes.map((outcome) => (
            <article>
              <h3>{outcome.label}</h3>
              <p>{outcome.detail}</p>
              <p class="label">{outcome.context}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="band" id="capabilities" aria-labelledby="leadership-heading">
      <h2 id="leadership-heading">Laboratory experience</h2>
      <div class="leadership">
        <article>
          <h3>Analytical methods</h3>
          <p>I work on trace-element methods and untargeted LC-MS/MS profiling.</p>
        </article>
        <article>
          <h3>Quality systems</h3>
          <p>
            My work includes ISO/IEC 17025-aligned documentation, GMP batch review, deviation
            investigations, and stability testing.
          </p>
        </article>
        <article>
          <h3>Laboratory instrumentation</h3>
          <p>I helped commission the analytical lab at Delic Labs.</p>
        </article>
      </div>
      <details>
        <summary>Mass spectrometry platforms and separations</summary>
        <p>{domains[0].blurb}</p>
      </details>
      <a class="section-link" href="/about/"
        >More about my experience <span aria-hidden="true">→</span></a
      >
    </section>

    <section class="band" id="research" aria-labelledby="research-heading">
      <h2 id="research-heading">Selected research</h2>
      <div class="research">
        <div>
          <article>
            <p class="label">University of Victoria · PhD</p>
            <h3>Real-time reaction monitoring</h3>
            <p>
              I used mass spectrometry and UV–Vis to follow palladium precatalyst activation in real
              time.
            </p>
            <a href="https://pubs.rsc.org/en/content/articlelanding/2017/cc/c6cc08824d"
              >Read the palladium paper <span aria-hidden="true">↗</span></a
            >
          </article>
          <article>
            <p class="label">University of Glasgow · Postdoctoral research</p>
            <h3>Ion mobility and cluster chemistry</h3>
            <p>
              I used ion mobility and high-resolution mass spectrometry to study how the choice of
              reducing sugar affects which polyoxometalate isomers form.
            </p>
            <a href="https://eprints.gla.ac.uk/186345/"
              >Read the cluster chemistry paper <span aria-hidden="true">↗</span></a
            >
          </article>
        </div>
        <figure>
          <img
            src="/assets/images/c9cc02361e-f3_hi-res.png"
            alt="Mass spectrum with an inset mapping drift time against mass-to-charge ratio for polyoxometalate ions"
            width="952"
            height="746"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            Ion mobility helped distinguish the reduced gamma isomer from overlapping signals in the
            mass spectrum. Reproduced from <a
              href="https://pubs.rsc.org/en/content/articlehtml/2019/cc/c9cc02361e"
              >Janusson et al., <em>Chemical Communications</em> (2019), Fig. 3</a
            >, first published by the Royal Society of Chemistry.
          </figcaption>
        </figure>
      </div>
      <a class="section-link" href="/publications/"
        >All publications <span aria-hidden="true">→</span></a
      >
    </section>

    <section class="band" id="work" aria-labelledby="software-heading">
      <h2 id="software-heading">Scientific software</h2>
      <div class="software">
        {
          featuredProjects.map((project) => (
            <article>
              <p class="label">
                {project.visibility === "public" ? "Open source · MIT" : "Private · Proprietary"}
              </p>
              <h3>
                <a href={`/projects/#${project.slug}`}>{project.name}</a>
              </h3>
              <p>{softwareScope[project.slug]}</p>
              {project.links.map((link) => (
                <a class="project-link" href={link.href}>
                  {link.label} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </article>
          ))
        }
      </div>
      <a class="section-link" href="/projects/">All projects <span aria-hidden="true">→</span></a>
    </section>

    <section class="band contact" id="contact" aria-labelledby="contact-heading">
      <h2 id="contact-heading">Contact</h2>
      <p>
        I'm open to roles in analytical chemistry, mass spectrometry, and laboratory leadership, as
        well as research collaborations.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href={email.href}>{email.value}</a>
        <a href={linkedIn.href}>LinkedIn <span aria-hidden="true">↗</span></a>
        <a href="/contact/">Contact details <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  :global(.content-container:has(.portfolio)) {
    max-width: 70rem;
  }

  .portfolio {
    --rule: color-mix(in srgb, var(--color-accent) 30%, var(--color-bg));
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(8rem, 25%);
    align-items: center;
    gap: clamp(1.25rem, 5vw, 4rem);
    padding-block: clamp(1.5rem, 5vw, 4.5rem) clamp(2.5rem, 6vw, 5rem);
  }

  .portfolio h1 {
    margin: 0.25em 0;
    color: var(--color-text);
    font-size: clamp(2.25rem, 5.7vw, 5.2rem);
    line-height: 1.02;
    letter-spacing: -0.065em;
  }

  h1 span {
    color: var(--color-heading);
  }

  .specialty {
    max-width: 30ch;
    color: var(--color-heading);
    font-size: clamp(1.14rem, 2vw, 1.65rem);
    line-height: 1.35;
    font-weight: 550;
  }

  .portfolio .intro {
    color: var(--color-text);
  }

  .portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--rule);
    padding: 0.4rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.4rem;
    margin-top: 1.5rem;
  }

  .actions a,
  .section-link,
  .project-link {
    font-weight: 600;
  }

  .band {
    border-top: 1px solid var(--rule);
    padding-block: clamp(1.85rem, 4.5vw, 3.6rem);
  }

  .portfolio h2 {
    margin: 0 0 1.25rem;
    padding: 0;
    border: 0;
    font-size: clamp(1.55rem, 3vw, 2.6rem);
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .portfolio h3 {
    margin: 0 0 0.45rem;
    font-size: 1.08rem;
    line-height: 1.35;
  }

  .portfolio article p {
    color: var(--color-text);
  }
  .portfolio article p.label,
  .portfolio p.label,
  figcaption {
    color: var(--color-sidebar-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.55;
  }

  .label {
    margin: 0 0 0.65rem;
  }

  .outcomes,
  .leadership,
  .software,
  .research {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr);
  }

  .outcomes article,
  .software article {
    padding: clamp(1rem, 2.4vw, 1.65rem);
    border: 1px solid var(--rule);
    background: var(--color-card-bg);
  }

  .outcomes .label {
    margin: 1rem 0 0;
  }

  .leadership article {
    padding-top: 1rem;
    border-top: 2px solid var(--rule);
  }

  details {
    margin: 0.75rem 0;
  }
  summary {
    cursor: pointer;
    color: var(--color-accent);
  }
  details p {
    margin-top: 0.7rem;
  }

  .research article + article {
    margin-top: 1.5rem;
  }

  .research figure {
    margin: 0;
    padding: 0.75rem;
    border: 1px solid var(--rule);
    align-self: start;
  }

  .research img {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 0.65rem;
  }
  .project-link {
    display: inline-block;
    margin-right: 0.75rem;
    font-size: 0.88rem;
  }
  .section-link {
    display: inline-block;
    margin-top: 1.15rem;
  }
  .contact p {
    max-width: 62ch;
  }

  @media (max-width: 560px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .portrait {
      display: none;
    }
  }

  @media (min-width: 640px) {
    .outcomes,
    .software {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 980px) {
    .leadership,
    .software {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .research {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: 2rem;
    }
  }

  @media (min-width: 1340px) {
    .outcomes {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
