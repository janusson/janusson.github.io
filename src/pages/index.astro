---
/**
 * Homepage — positions Eric as a Computational Analytical Chemist.
 *
 * Layout: thesis-first hero, then an evidence-driven Systems Deployed grid
 * (four case studies with metrics), followed by domains, writing, about,
 * and contact.
 *
 * Styling is standard Tailwind utilities (Kanagawa palette tokens:
 * text-kanagawa-gold, border-kanagawa-wave, …). Like SelectedWork.astro,
 * utilities that conflict with BaseLayout's unlayered base styles use
 * the `!` important modifier.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SpectralNetwork from "../components/Visualizations/SpectralNetwork.astro";
import SelectedWork from "../components/SelectedWork.astro";
import type { CaseStudy } from "../components/SelectedWork.astro";
import { domains, contactLinks } from "../data/projects";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const featuredPosts = posts.slice(0, 3);
const hasMorePosts = posts.length > 3;

/**
 * Four major case studies — evidence and metrics preferred over descriptions.
 * MassFlow and MSMCP link out to their repos; the two lab engagements
 * are reserved for future long-form case study pages.
 */
const selectedWork: CaseStudy[] = [
  {
    slug: "delic-labs",
    organization: "Delic Labs",
    role: "Lead Chemist",
    timeline: "2021 – 2022",
    title: "Commissioning a federally authorized analytical facility",
    summary:
      "Took a new laboratory from empty benches to federal authorization: ISO/IEC 17025-aligned workflows and SOPs, then a computational pipeline that annotated more than 9,500 spectra across botanical products.",
    metric: {
      value: "9,500+",
      label: "spectra annotated by the in-house DIA-LC-MS/MS pipeline",
    },
    evidence: [
      "Facility commissioned end-to-end — instruments, workflows, SOPs",
      "ISO/IEC 17025-aligned QA/QC framework established",
      "Untargeted DIA-LC-MS/MS profiling pipeline for botanical matrices",
    ],
    tags: ["Facility Commissioning", "ISO/IEC 17025", "DIA-LC-MS/MS"],
  },
  {
    slug: "massflow",
    organization: "MassFlow",
    role: "Author & Maintainer",
    timeline: "Open Source",
    title: "From HRMS research to an open-source MS/MS toolkit",
    summary:
      "A config-first, vendor-agnostic Python toolkit for MS/MS annotation — custom spectral similarity scoring, version-controlled spectral libraries, and interactive molecular networking, distilled from a decade of HRMS research.",
    metric: {
      value: "MIT",
      label: "open-source · vendor-agnostic · config-first",
    },
    evidence: [
      "MS/MS annotation with custom spectral similarity scoring",
      "Version-controlled, reproducible spectral libraries",
      "Interactive molecular networking visualization",
    ],
    tags: ["Python", "MS/MS Annotation", "Molecular Networking"],
    href: "https://github.com/janusson/MassFlow",
    external: true,
  },
  {
    slug: "msmcp",
    organization: "MSMCP",
    role: "Author & Maintainer",
    timeline: "Open Source",
    title: "Giving AI agents direct access to mass spectrometry data",
    summary:
      "A Model Context Protocol server that exposes raw and processed MS datasets as queryable tools and resources — AI assistants analyze the data directly instead of through copy-paste.",
    metric: {
      value: "MCP",
      label: "Model Context Protocol server for mass spectrometry",
    },
    evidence: [
      "Raw MS datasets exposed as queryable agent tools",
      "Processed results served as structured resources",
      "Python · stdio transport · MIT licensed",
    ],
    tags: ["Python", "MCP", "AI × Mass Spectrometry"],
    href: "https://github.com/janusson/MSMCP",
    external: true,
  },
  {
    slug: "tmc-manufacturing",
    organization: "TMC Manufacturing",
    role: "Principal Scientist, Analytical Development & Laboratory Operations",
    timeline: "2024 – 2026",
    title: "Internalizing elemental analysis for 5N+ isotope production",
    summary:
      "Brought trace-element analysis in-house for ultra-high-purity stable-isotope production — authored a $515k ICP-MS capital procurement and a sub-2 ppm potentiometric assay supporting ≥99.999% purity certification.",
    metric: {
      value: "$515k",
      label: "Capital equipment procurement, authored and internally justified",
    },
    evidence: [
      "Elemental analysis internalized, removing external lab dependency",
      "Sub-2 ppm potentiometric assay developed and validated",
      "Trace-element methods supporting 5N+ purity certification",
    ],
    tags: ["ICP-MS", "Method Validation", "5N+ Certification"],
  },
];
---

<BaseLayout
  title="Eric Janusson — Computational Analytical Chemist · Mass Spectrometry · Scientific Software"
  description="I build analytical systems and software for mass spectrometry — PhD analytical chemist, regulated laboratories, open-source MS/MS tooling."
>
  <!-- Animated background: anchored to the top of the page so it scrolls
       away with the content; the IntersectionObserver inside the component
       pauses the simulation once it's out of view. -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 z-0 h-screen"
    slot="background"
    aria-hidden="true"
  >
    <SpectralNetwork />
  </div>

  <!-- ═══ Hero — the thesis, stated immediately ═══ -->
  <section
    class="relative z-10 bg-[linear-gradient(to_right,rgba(24,22,22,0.55),transparent)] px-5! pt-12! pb-10! backdrop-blur-[3px] md:pt-14!"
  >
    <p class="eyebrow">Mass Spectrometry · Scientific Software · Analytical Automation</p>
    <h1 class="mt-4! max-w-3xl text-[clamp(1.9rem,4.5vw,3rem)]! leading-[1.15]!">
      AI-Powered Chemical Analytics.
    </h1>
    <p class="mt-5! max-w-2xl text-[1.05rem] leading-relaxed">
      I'm a PhD analytical chemist specializing in mass spectrometry, regulated laboratories, and
      reproducible computational workflows.
    </p>
    <div class="mt-8! flex flex-wrap items-center gap-3">
      <a href="#projects" class="btn btn--primary btn--large"
        >Explore selected work <span aria-hidden="true">&darr;</span></a
      >
      <a href="/cv/" class="btn btn--cv btn--large"
        >View CV <span aria-hidden="true">&rarr;</span></a
      >
      <a href="/about/" class="text-sm font-semibold"
        >More about me <span aria-hidden="true">&rarr;</span></a
      >
    </div>
  </section>

  <!-- ═══ Active Research — terminal-style changelog ═══ -->
  <section class="relative z-10 py-10! md:py-12!" id="research">
    <header class="mb-6!">
      <p class="eyebrow">Log</p>
      <h2 class="mt-0!">Active Research</h2>
    </header>
    <ul class="term-list">
      <li>
        Integration of self-supervised foundation models into `MSMCP` to enable predictive
        cheminformatics.
      </li>
      <li>Serverless edge deployment of stateless model context protocol for `MSMCP`.</li>
      <li>
        Vectorized implementation of projection approximation to model collisional cross-sections
        (CCS) from molecular coordinates.
      </li>
    </ul>
  </section>

  <!-- ═══ Systems Deployed ═══
       id="projects" preserves the historical in-page anchor target. -->
  <section class="vignette relative z-10 py-11!" id="projects">
    <header class="mb-6!">
      <p class="eyebrow">Timeline</p>
      <h2 class="mt-0!">What I've Worked on</h2>
    </header>
    <SelectedWork caseStudies={selectedWork} />
    <p class="mt-8! text-center">
      <a href="/projects/" class="btn btn--primary"
        >All projects <span aria-hidden="true">&rarr;</span></a
      >
    </p>
  </section>

  <!-- ═══ What I Work On ═══ -->
  <section class="vignette relative z-10 py-11!" id="domains">
    <header class="mb-6!">
      <p class="eyebrow">What I Work On</p>
      <h2 class="mt-0!">Bench science meets software engineering</h2>
    </header>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        domains.map((domain) => (
          <div class="rounded-lg border border-kanagawa-wave bg-[var(--color-card-bg)] p-5! backdrop-blur-[4px] transition hover:-translate-y-0.5 hover:border-kanagawa-accent">
            <i class:list={[domain.icon, "text-lg text-kanagawa-gold"]} aria-hidden="true" />
            <h3 class="mt-3! mb-1! text-base!">{domain.title}</h3>
            <p class="m-0! text-sm leading-relaxed opacity-80">{domain.blurb}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ═══ Selected Writing ═══ -->
  <section class="relative z-10 py-11!" id="writing">
    <header class="mb-6!">
      <p class="eyebrow">Selected Writing</p>
      <h2 class="mt-0!">Notes from the lab and the terminal</h2>
    </header>

    {
      featuredPosts.map((post) => (
        <article class="post-card">
          <h2>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </h2>
          <p class="post-meta">
            {post.data.date.toLocaleDateString("en-CA", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </p>
          {post.data.description && <p>{post.data.description}</p>}
          {post.data.tags.length > 0 && (
            <div class="post-tags">
              {post.data.tags.slice(0, 3).map((tag) => (
                <span class="post-tag">{tag}</span>
              ))}
            </div>
          )}
        </article>
      ))
    }

    {
      hasMorePosts && (
        <p class="mt-8! text-center">
          <a href="/posts/" class="btn btn--primary">
            View all posts <span aria-hidden="true">&rarr;</span>
          </a>
        </p>
      )
    }
  </section>

  <!-- ═══ About ═══ -->
  <section class="relative z-10 py-11!" id="about">
    <header class="mb-6!">
      <p class="eyebrow">About</p>
      <h2 class="mt-0!">From the bench to the terminal</h2>
    </header>
    <p class="max-w-[42em] leading-relaxed">
      Over a decade of chemical analytics — electrospray ionization fundamentals, ISO/IEC 17025
      laboratories, ultra-high-purity isotope production — followed by a move into full-time
      scientific software. I care about reproducibility, validation, and tools built for the long
      haul.
    </p>
    <p class="mt-8!">
      <a href="/about/" class="btn btn--primary"
        >More about me <span aria-hidden="true">&rarr;</span></a
      >
    </p>
  </section>

  <!-- ═══ CV & Contact ═══ -->
  <section class="relative z-10 py-11!" id="contact">
    <header class="mb-6!">
      <p class="eyebrow">CV &amp; Contact</p>
      <h2 class="mt-0!">Let's work together</h2>
    </header>
    <p class="max-w-[40em] leading-relaxed">
      Consulting, speaking, research collaborations, or questions about my open-source tools — the
      fastest ways to reach me:
    </p>
    <div class="mt-6!">
      <a href="/cv/" class="btn btn--cv btn--large"
        >View CV <span aria-hidden="true">&rarr;</span></a
      >
    </div>
    <ul class="m-0! flex list-none flex-col gap-2 p-0!">
      {
        contactLinks.map((link) => (
          <li class="m-0!">
            <a
              class="flex flex-wrap items-center gap-3 rounded-lg border border-kanagawa-wave bg-[var(--color-card-bg)] p-3.5! transition hover:-translate-y-0.5 hover:border-kanagawa-accent"
              href={link.href}
              target={link.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
            >
              <i class:list={[link.icon, "w-[1.2em] text-kanagawa-gold"]} aria-hidden="true" />
              <span class="min-w-[5.5em] text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-kanagawa-accent">
                {link.label}
              </span>
              <span class="ml-auto! font-[family-name:var(--font-mono)] text-[0.88rem] opacity-85">
                {link.value}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  /* Wider column on the homepage for the grid layouts (prose pages keep
     the 48rem default). */
  :global(.content-container) {
    max-width: 62rem;
  }

  /* Terminal-style log: muted monospace entries on a quiet backdrop. */
  .term-list {
    margin: 0;
    padding: 1.25rem 1.5rem;
    list-style: none;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: rgba(13, 12, 12, 0.55);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--color-sidebar-muted);
  }

  .term-list li {
    position: relative;
    padding-left: 1.75em;
    line-height: 1.7;
  }

  .term-list li + li {
    margin-top: 0.35em;
  }

  .term-list li::before {
    content: "›";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }
</style>
