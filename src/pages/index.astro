---
/**
 * Homepage — the professional front door for Dr. Eric Janusson.
 *
 * Thesis-first: the page opens with what the work produces (defensible
 * decisions from laboratory measurements) rather than with a name or a
 * technology list. Then measurement outcomes, then the software that
 * carries a measurement to a decision, then the AI layer as an amplifier.
 *
 * Layout: thesis hero over a full-viewport animated spectral-network
 * background (rendered through BaseLayout's `background` slot).
 *
 * Styling is standard Tailwind utilities (Kanagawa palette tokens). Like
 * the other Tailwind pages, utilities that conflict with BaseLayout's
 * unlayered base styles use the `!` important modifier.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import SpectralNetwork from "../components/Visualizations/SpectralNetwork.astro";
import SelectedWork from "../components/SelectedWork.astro";
import type { CaseStudy } from "../components/SelectedWork.astro";
import { contactLinks, domains, featuredProjects } from "../data/projects";
import { getCollection } from "astro:content";

const publicationCount = (await getCollection("publications")).length;

/**
 * Measurement outcomes. Every figure here is in the career record and is
 * the only quantified claim this page makes:
 *   >$100k/yr saved · >$500k procurement · ≥99.999% purity · >9,500 spectra
 */
const outcomes = [
  {
    value: ">$100k/yr",
    label: "External testing eliminated",
    detail:
      "Validated trace-analysis methods brought in house, and out-of-spec product reduced by a validated assay.",
    context: "TMC Manufacturing · Principal Scientist",
  },
  {
    value: ">$500k",
    label: "Capital instrumentation procured",
    detail:
      "Capital procurement for automated analytical instrumentation, with the ICP-MS platform specified and commissioned alongside the vendor.",
    context: "TMC Manufacturing · Principal Scientist",
  },
  {
    value: "≥99.999%",
    label: "Purity verified at spec",
    detail:
      "Regulated trace-element methods for ultra-high-purity stable-isotope production, under GMP batch review, deviation investigation, and stability testing.",
    context: "TMC Manufacturing · Principal Scientist",
  },
  {
    value: ">9,500",
    label: "Spectra made machine-readable",
    detail:
      "Untargeted DIA LC-MS/MS workflow over botanical, fungal, and pharmaceutical samples, annotated through a reproducible Python pipeline.",
    context: "Delic Labs · Lead Chemist",
  },
];

const selectedWork: CaseStudy[] = [
  ...featuredProjects.map((project) => {
    const githubHref = project.links.find((link) => link.label === "GitHub")?.href;
    const isProprietary = project.visibility === "proprietary";
    return {
      slug: project.slug,
      organization: project.name,
      role: isProprietary ? "Author" : "Author & Maintainer",
      timeline: isProprietary ? "Proprietary" : "Open Source",
      badge: isProprietary ? "Private · Proprietary" : "Open Source · MIT",
      title: project.tagline,
      summary: project.description,
      metric: project.metric,
      evidence: [project.approach],
      tags: project.tech,
      href: isProprietary ? `/projects/#${project.slug}` : githubHref,
      external: !isProprietary,
      linkLabel: isProprietary ? "Scope & details" : "View on GitHub",
    };
  }),
  {
    slug: "reaction-monitoring",
    organization: "Research",
    role: "First author",
    timeline: "Chemical Communications",
    badge: "Peer-Reviewed",
    title: "Monitoring palladium precatalyst activation in real time",
    summary:
      "Mass spectrometric reaction monitoring applied to the activation of a palladium precatalyst by phosphine ligands.",
    metric: { value: "ESI-MS", label: "real-time reaction monitoring" },
    evidence: ["Pressurized sample infusion", "Published research with an accessible citation"],
    tags: ["Reaction Monitoring", "Mass Spectrometry"],
    href: "https://doi.org/10.1039/C6CC08824D",
    external: true,
    linkLabel: "Read the paper",
  },
];
---

<BaseLayout
  title="Dr. Eric Janusson — PhD Analytical Chemist · Mass Spectrometry · Scientific Software"
  description="Dr. Eric Janusson — PhD analytical chemist and mass spectrometrist in British Columbia, Canada. Validated methods, CMC instrumentation, laboratory technical leadership, and scientific Python software."
>
  <!-- Animated background: anchored to the top of the page so it scrolls
       away with the content; the IntersectionObserver inside the component
       pauses the simulation once it's out of view. -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 z-0 h-screen"
    slot="background"
    aria-hidden="true"
  >
    <SpectralNetwork />
  </div>

  <!-- ═══ Hero — identity, value proposition, and evidence immediately ═══ -->
  <section
    class="relative z-10 bg-[linear-gradient(to_right,rgba(24,22,22,0.65),transparent)] px-5! pt-12! pb-10! backdrop-blur-[3px] md:pt-14!"
  >
    <p class="eyebrow">Dr. Eric Janusson · PhD Analytical Chemistry · British Columbia, Canada</p>
    <h1 class="mt-4! max-w-3xl text-[clamp(1.9rem,4.5vw,3rem)]! leading-[1.15]!">
      Turning laboratory measurements into defensible decisions.
    </h1>
    <p class="mt-5! max-w-2xl text-[1.05rem] leading-relaxed">
      Analytical chemist, mass spectrometrist, and scientific Python developer with a decade across
      academic research (University of Victoria PhD; University of Glasgow postdoc), regulated
      laboratory leadership (Principal Scientist; Lead Chemist), and open-source mass spectrometry
      software.
    </p>
    <p class="mt-4! max-w-2xl text-[0.98rem] leading-relaxed text-kanagawa-text!">
      Focused on senior analytical science, mass spectrometry, CMC, and scientific computing roles —
      based in British Columbia and open to opportunities beyond my immediate region as well as
      selective technical collaborations.
    </p>
    <div class="mt-8! flex flex-wrap items-center gap-x-5 gap-y-3">
      <a href="/contact/" class="btn btn--primary btn--large"
        >Get in touch <span aria-hidden="true">&rarr;</span></a
      >
      <a href="#measurement" class="text-sm font-semibold"
        >Outcomes &amp; evidence <span aria-hidden="true">&darr;</span></a
      >
      <a href="/about/" class="text-sm font-semibold"
        >Experience &amp; profile <span aria-hidden="true">&rarr;</span></a
      >
      <a href="/publications/" class="text-sm font-semibold"
        >Publications ({publicationCount}) <span aria-hidden="true">&rarr;</span></a
      >
    </div>
  </section>

  <!-- ═══ Measurement & Validation — outcomes, not capability lists ═══ -->
  <section class="vignette relative z-10 py-11!" id="measurement">
    <header class="mb-6!">
      <p class="eyebrow">Measurement &amp; Validation</p>
      <h2 class="mt-0!">What the system has to do before a result can be believed</h2>
    </header>
    <p class="mb-7 max-w-[46em] leading-relaxed">
      Method development, instrument commissioning, and quality systems are the same job at three
      points in one chain. These are the documented outcomes from academic and regulated laboratory
      leadership.
    </p>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        outcomes.map((outcome) => (
          <article class="rounded-lg border border-kanagawa-wave bg-[var(--color-card-bg)] p-5! backdrop-blur-[4px] transition hover:-translate-y-0.5 hover:border-kanagawa-accent">
            <p class="m-0! font-[family-name:var(--font-mono)] text-2xl font-semibold text-kanagawa-gold">
              {outcome.value}
            </p>
            <h3 class="mt-2! mb-1.5! text-base!">{outcome.label}</h3>
            <p class="m-0! text-sm leading-relaxed">{outcome.detail}</p>
            <p class="mt-3! mb-0! text-[0.72rem] tracking-[0.06em] uppercase text-kanagawa-muted!">
              {outcome.context}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ═══ Capabilities & Instrumentation — verified technical breadth ═══ -->
  <section class="vignette relative z-10 py-11!" id="capabilities">
    <header class="mb-6!">
      <p class="eyebrow">Capabilities &amp; Instrumentation</p>
      <h2 class="mt-0!">Core analytical, regulatory, and computational scope</h2>
    </header>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        domains.map((domain) => (
          <article class="rounded-lg border border-kanagawa-wave bg-[var(--color-card-bg)] p-4! backdrop-blur-[4px]">
            <div class="flex items-center gap-2.5">
              <Icon name={domain.icon} class="h-[1.1em] w-[1.1em] shrink-0 text-kanagawa-gold" />
              <h3 class="m-0! text-sm! font-semibold text-kanagawa-gold!">{domain.title}</h3>
            </div>
            <p class="mt-2.5! mb-0! text-sm leading-relaxed">{domain.blurb}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ═══ Scientific Software & Research — public vs proprietary clarity ═══ -->
  <section class="vignette relative z-10 py-11!" id="work">
    <header class="mb-6!">
      <p class="eyebrow">Selected Software &amp; Research</p>
      <h2 class="mt-0!">Software that carries a measurement to a decision</h2>
    </header>
    <p class="mb-7 max-w-[46em] leading-relaxed">
      None of this software identifies compounds on its own authority. Each system records what it
      did, what it could not verify, and where the evidence stops — with public MIT repositories
      clearly distinguished from private proprietary work.
    </p>
    <SelectedWork caseStudies={selectedWork} />
    <div class="mt-6! flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-semibold">
      <a href="/projects/">All software projects (including PySharpe) &rarr;</a>
      <a href="/publications/">Full publication record ({publicationCount} works) &rarr;</a>
    </div>
  </section>

  <!-- ═══ Applied AI — amplifier, not identity ═══ -->
  <section class="vignette relative z-10 py-11!" id="ai">
    <header class="mb-6!">
      <p class="eyebrow">Applied AI</p>
      <h2 class="mt-0!">An amplifier on the measurement chain, not a substitute for judgment</h2>
    </header>
    <p class="max-w-[46em] leading-relaxed">
      <a href="https://msmcp.dev/" target="_blank" rel="noopener noreferrer">MSMCP</a> exposes mass spectrometry
      data and computations to MCP-compatible clients so an agent can query a dataset directly instead
      of being handed an export. It is deliberately narrow: it reports what it computed and what it could
      not, and it carries no significance claim. The same boundary that made me withdraw the library-search
      p-values applies to anything an agent asks it — access to the measurement is not authority over
      the interpretation.{" "}
      <a href="/blog/2026-11-16-msmcp-architecture-and-provenance/"
        >Architecture &amp; provenance notes &rarr;</a
      >
    </p>
  </section>

  <!-- ═══ Contact ═══ -->
  <section class="vignette relative z-10 py-11!" id="contact">
    <header class="mb-6!">
      <p class="eyebrow">Contact</p>
      <h2 class="mt-0!">Discuss a role or collaboration</h2>
    </header>
    <p class="max-w-[42em] leading-relaxed">
      Available for senior roles in analytical science, mass spectrometry, CMC, and scientific
      computing — based in British Columbia, Canada, and open to opportunities beyond my immediate
      region as well as selective consulting. The fastest ways to reach me:
    </p>
    <ul class="m-0! flex list-none flex-col gap-2 p-0!">
      {
        contactLinks.map((link) => (
          <li class="m-0!">
            <a
              class="flex flex-wrap items-center gap-3 rounded-lg border border-kanagawa-wave bg-[var(--color-card-bg)] p-3.5! transition hover:-translate-y-0.5 hover:border-kanagawa-accent"
              href={link.href}
              target={link.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
            >
              <Icon name={link.icon} class="h-[1.2em] w-[1.2em] shrink-0 text-kanagawa-gold" />
              <span class="min-w-[5.5em] text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-kanagawa-accent">
                {link.label}
              </span>
              <span class="ml-auto! font-[family-name:var(--font-mono)] text-[0.88rem]">
                {link.value}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  /* Wider column on the homepage for the card grids (prose pages keep
     the 48rem default). */
  :global(.content-container) {
    max-width: 62rem;
  }
</style>
