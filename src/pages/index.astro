---
/**
 * Homepage — positions Eric as a Computational Analytical Chemist.
 *
 * Layout: thesis-first hero, then an evidence-driven Systems Deployed grid
 * (four case studies with metrics), followed by domains, writing, about,
 * and contact.
 *
 * Styling is standard Tailwind utilities (Kanagawa palette tokens:
 * text-kanagawa-gold, border-kanagawa-wave, …). Like SelectedWork.astro,
 * utilities that conflict with BaseLayout's unlayered base styles use
 * the `!` important modifier.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SpectralNetwork from "../components/Visualizations/SpectralNetwork.astro";
import SelectedWork from "../components/SelectedWork.astro";
