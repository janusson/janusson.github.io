---
/**
 * Homepage — the professional front door for Dr. Eric Janusson.
 *
 * Layout: name-first hero over a full-viewport animated spectral-network
 * background (rendered through BaseLayout's `background` slot), followed by
 * selected research and software, the "What I Work On" domain grid,
 * and contact channels.
 *
 * Styling is standard Tailwind utilities (Kanagawa palette tokens). Like
 * the other Tailwind pages, utilities that conflict with BaseLayout's
 * unlayered base styles use the `!` important modifier.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import SpectralNetwork from "../components/Visualizations/SpectralNetwork.astro";
import SelectedWork from "../components/SelectedWork.astro";
import type { CaseStudy } from "../components/SelectedWork.astro";
import { domains, contactLinks, featuredProjects } from "../data/projects";

const selectedWork: CaseStudy[] = [
  {
    slug: "reaction-monitoring",
    organization: "Research",
    role: "First author",
    timeline: "Chemical Communications",
    title: "Monitoring palladium precatalyst activation in real time",
    summary:
      "Mass spectrometric reaction monitoring applied to the activation of a palladium precatalyst by phosphine ligands.",
    metric: { value: "ESI-MS", label: "real-time reaction monitoring" },
    evidence: ["Pressurized sample infusion", "Published research with an accessible citation"],
    tags: ["Reaction Monitoring", "Mass Spectrometry"],
    href: "https://doi.org/10.1039/C6CC08824D",
    external: true,
    linkLabel: "Read the paper",
  },
  ...featuredProjects.map((project) => ({
    slug: project.slug,
    organization: project.name,
    role: "Author & Maintainer",
    timeline: "Open Source",
    title: project.tagline,
    summary: project.description,
    metric: {
      value: "Python",
      label: project.meta.find((item) => item.label === "Domain")?.value ?? "Open source",
    },
    evidence: [project.approach],
    tags: project.tech,
    href: project.links.find((link) => link.label === "GitHub")?.href,
    external: true,
    linkLabel: "View on GitHub",
  })),
];
---

<BaseLayout
  title="Dr. Eric Janusson — Analytical Chemist · Mass Spectrometry · Scientific Software"
  description="Dr. Eric Janusson is an analytical chemist and mass spectrometrist — PhD, peer-reviewed publications, regulated laboratory experience, and open-source software for mass spectrometry. Available for consulting and research collaborations."
>
  <!-- Animated background: anchored to the top of the page so it scrolls
       away with the content; the IntersectionObserver inside the component
       pauses the simulation once it's out of view. -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 z-0 h-screen"
    slot="background"
    aria-hidden="true"
  >
    <SpectralNetwork />
  </div>

  <!-- ═══ Hero — the professional identity, stated immediately ═══ -->
  <section
    class="relative z-10 bg-[linear-gradient(to_right,rgba(24,22,22,0.55),transparent)] px-5! pt-12! pb-10! backdrop-blur-[3px] md:pt-14!"
  >
    <p class="eyebrow">Analytical Chemistry · Mass Spectrometry · Scientific Software</p>
    <h1 class="mt-4! max-w-3xl text-[clamp(1.9rem,4.5vw,3rem)]! leading-[1.15]!">
      Dr. Eric Janusson
    </h1>
    <p class="mt-5! max-w-2xl text-[1.05rem] leading-relaxed">
      Analytical chemist and mass spectrometrist. I've spent more than a decade making mass
      spectrometry measurements trustworthy — from the physics of ion formation, to watching
      catalytic reactions in real time, to methods and software that hold up in regulated
      laboratories.
    </p>
    <p class="mt-4! max-w-2xl text-[0.98rem] leading-relaxed text-kanagawa-muted!">
      PhD from the University of Victoria, postdoctoral research at the University of Glasgow, and
      published research in mass spectrometry and reaction monitoring. See the
      <a href="/publications/">publication record</a> for the underlying work.
    </p>
    <div class="mt-8! flex flex-wrap items-center gap-x-5 gap-y-3">
      <a href="#work" class="btn btn--primary btn--large"
        >Selected work <span aria-hidden="true">&darr;</span></a
      >
      <a href="/about/" class="text-sm font-semibold"
        >Professional profile <span aria-hidden="true">&rarr;</span></a
      >
      <a href="/contact/" class="text-sm font-semibold"
        >Get in touch <span aria-hidden="true">&rarr;</span></a
      >
    </div>
  </section>

  <!-- ═══ Selected work — outcomes, not adjectives ═══ -->
  <section class="vignette relative z-10 py-11!" id="work">
    <header class="mb-6!">
      <p class="eyebrow">Selected Work</p>
      <h2 class="mt-0!">Research and software you can inspect</h2>
    </header>
    <SelectedWork caseStudies={selectedWork} />
  </section>

  <!-- ═══ What I Work On ═══ -->
  <section class="vignette relative z-10 py-11!" id="domains">
    <header class="mb-6!">
      <p class="eyebrow">What I Work On</p>
      <h2 class="mt-0!">Bench science meets software engineering</h2>
    </header>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        domains.map((domain) => (
          <div class="rounded-lg border border-kanagawa-wave bg-[var(--color-card-bg)] p-5! backdrop-blur-[4px] transition hover:-translate-y-0.5 hover:border-kanagawa-accent">
            <Icon name={domain.icon} class="text-lg text-kanagawa-gold" />
            <h3 class="mt-3! mb-1! text-base!">{domain.title}</h3>
            <p class="m-0! text-sm leading-relaxed opacity-80">{domain.blurb}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ═══ Contact ═══ -->
  <section class="vignette relative z-10 py-11!" id="contact">
    <header class="mb-6!">
      <p class="eyebrow">Contact</p>
      <h2 class="mt-0!">Let's work together</h2>
    </header>
    <p class="max-w-[40em] leading-relaxed">
      Senior analytical roles, consulting, collaborations, or questions about my open-source tools —
      the fastest ways to reach me:
    </p>
    <ul class="m-0! flex list-none flex-col gap-2 p-0!">
      {
        contactLinks.map((link) => (
          <li class="m-0!">
            <a
              class="flex flex-wrap items-center gap-3 rounded-lg border border-kanagawa-wave bg-[var(--color-card-bg)] p-3.5! transition hover:-translate-y-0.5 hover:border-kanagawa-accent"
              href={link.href}
              target={link.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
            >
              <Icon name={link.icon} class="h-[1.2em] w-[1.2em] shrink-0 text-kanagawa-gold" />
              <span class="min-w-[5.5em] text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-kanagawa-accent">
                {link.label}
              </span>
              <span class="ml-auto! font-[family-name:var(--font-mono)] text-[0.88rem] opacity-85">
                {link.value}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  /* Wider column on the homepage for the card grids (prose pages keep
     the 48rem default). */
  :global(.content-container) {
    max-width: 62rem;
  }
</style>
