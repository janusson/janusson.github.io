---
/**
 * Homepage — positions Eric as a Computational Analytical Chemist.
 *
 * Layout: thesis-first hero over a full-viewport animated spectral-network
 * background (rendered through BaseLayout's `background` slot).
 *
 * Styling is standard Tailwind utilities (Kanagawa palette tokens). Like
 * the other Tailwind pages, utilities that conflict with BaseLayout's
 * unlayered base styles use the `!` important modifier.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SpectralNetwork from "../components/Visualizations/SpectralNetwork.astro";
---

<BaseLayout
  title="Eric Janusson — Computational Analytical Chemist · Mass Spectrometry · Scientific Software"
  description="I build analytical systems and software for mass spectrometry — PhD analytical chemist, regulated laboratories, open-source MS/MS tooling."
>
  <!-- Animated background: anchored to the top of the page so it scrolls
       away with the content; the IntersectionObserver inside the component
       pauses the simulation once it's out of view. -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 z-0 h-screen"
    slot="background"
    aria-hidden="true"
  >
    <SpectralNetwork />
  </div>

  <!-- ═══ Hero — the thesis, stated immediately ═══ -->
  <section
    class="relative z-10 bg-[linear-gradient(to_right,rgba(24,22,22,0.55),transparent)] px-5! pt-12! pb-10! backdrop-blur-[3px] md:pt-14!"
  >
    <p class="eyebrow">Mass Spectrometry · Scientific Software · Analytical Automation</p>
    <h1 class="mt-4! max-w-3xl text-[clamp(1.9rem,4.5vw,3rem)]! leading-[1.15]!">
      Chemical Analytics and Open-Source Software.
    </h1>
    <p class="mt-5! max-w-2xl text-[1.05rem] leading-relaxed">
      I'm Eric, a chemist working on open-source mass spectrometry software. I build automated
      analytical systems. I post articles and resources on analytical chemistry and software
      development.
    </p>
    <div class="mt-8! flex flex-wrap items-center gap-3">
      <a href="/projects/" class="btn btn--primary btn--large"
        >Selected work <span aria-hidden="true">&rarr;</span></a
      >
      <a href="/about/" class="text-sm font-semibold"
        >More about me <span aria-hidden="true">&rarr;</span></a
      >
    </div>
  </section>
</BaseLayout>
