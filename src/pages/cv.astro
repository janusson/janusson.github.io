---
import BaseLayout from "../layouts/BaseLayout.astro";

// CV download — direct link, no verification gate.
//
// Bot protection: the filename stays opaque (random suffix) so the URL is
// not guessable, and an invisible honeypot link below trips naive
// link-harvesting crawlers. The PDF itself must remain a public asset so
// recruiters and no-JS clients reach it in one click; genuine rate
// limiting belongs at the CDN/server layer, which this static host does
// not provide.
const CV_PATH = "/assets/files/cv-914b7ab6-4449-4b93-89c5-726245d80598.pdf";
---

<BaseLayout
  title="CV / Résumé"
  description="Download Eric Janusson's CV — direct PDF download, no verification required."
>
  <h1>CV / Résumé</h1>

  <p class="cv-intro">No puzzles, no verification — my CV is one click away. Current as of 2026.</p>

  <div class="cv-download-card">
    <div class="cv-file-icon">
      <i class="fa-solid fa-file-pdf"></i>
    </div>
    <div class="cv-file-info">
      <strong>Curriculum Vitae</strong>
      <span class="cv-file-meta">PDF · Updated 2026</span>
    </div>
    <a href={CV_PATH} class="btn btn--cv btn--large" download>
      <i class="fa-solid fa-download"></i>&ensp;Download CV
    </a>
  </div>

  <p class="session-note">
    <i class="fa-solid fa-circle-info"></i>&ensp; Also reachable from the{" "}
    <a href="/">homepage</a>, the <a href="/about/">About page</a>, and the sidebar on every page.
  </p>

  <!-- Invisible honeypot — decoy "Download CV" link for link-harvesting
       crawlers. Humans never see it; bots that scrape anchor text follow
       it to a non-existent route, which shows up as a 404 tripwire in the
       access logs. -->
  <a
    href="/cv/download/trap"
    rel="nofollow"
    tabindex="-1"
    aria-hidden="true"
    style="position:absolute; left:-9999px; top:auto; width:1px; height:1px; overflow:hidden;"
  >
    Download CV
  </a>
</BaseLayout>

<style>
  .cv-intro {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-body);
    margin-bottom: 1.75rem;
    max-width: 40em;
  }

  .cv-download-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow:
      0 0 20px rgba(152, 187, 108, 0.08),
      inset 0 0 20px rgba(152, 187, 108, 0.02);
    flex-wrap: wrap;
  }

  .cv-file-icon {
    font-size: 2.5rem;
    color: #e82424;
    flex-shrink: 0;
  }

  .cv-file-info {
    flex: 1;
    min-width: 180px;
  }

  .cv-file-info strong {
    display: block;
    color: var(--color-heading);
    font-size: 1.05rem;
  }

  .cv-file-meta {
    font-size: 0.8rem;
    color: var(--color-sidebar-muted);
  }

  .session-note {
    font-size: 0.8rem;
    color: var(--color-sidebar-muted);
    margin: 0;
  }

  .session-note i {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .cv-download-card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
