---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeaturedProjectCard from "../components/FeaturedProjectCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout
  title="Projects"
  description="Scientific software by Eric Janusson: MassFlow, MSMCP, MassPilot, and PySharpe."
>
  <h1>Projects</h1>
  <p class="projects-intro">Scientific software I'm working on.</p>

  <div class="case-list">
    {projects.map((project) => <FeaturedProjectCard project={project} />)}
  </div>
</BaseLayout>

<style>
  .projects-intro {
    color: var(--color-sidebar-muted);
    margin-bottom: 2em;
  }

  .case-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
</style>
