<file path="src/styles/global.css">
/* ═══════════════════════════════════════════════════════════════════
   Kanagawa Design System  —  Tailwind v4
   ═══════════════════════════════════════════════════════════════════

   Imported by src/layouts/BaseLayout.astro so every page ships the
   utilities and theme variables used by the visualization components
   (React islands rendered inside MDX blog posts).

   NOTE: Tailwind's Preflight reset is intentionally NOT imported here.
   The site's base typography is hand-rolled in BaseLayout.astro as
   unlayered styles, and enabling Preflight would silently reset
   headings, list bullets, and form controls across every page.
   Revisit when the whole site is migrated to Tailwind.

   ═══════════════════════════════════════════════════════════════════ */

@layer theme, base, components, utilities;

@import "tailwindcss/theme.css" layer(theme);
@import "tailwindcss/utilities.css" layer(utilities);

/* ═══════════════════════════════════════════════════════════════════
   Theme tokens — matches the Kanagawa Dragon dark theme.

   Each token generates both a utility class AND a CSS custom property:
     • <prefix>-kanagawa-<name>   →  bg-kanagawa-bg, text-kanagawa-gold, …
     • --color-kanagawa-<name>    →  var(--color-kanagawa-accent), …

   Marked `static` so the variables are always emitted into :root —
   SVG glyphs reference them via var() from .tsx sources, which the
   utility scanner would not otherwise register as "usage".
   ═══════════════════════════════════════════════════════════════════ */

@theme static {
  --color-kanagawa-bg: #181616; /* Dragon Black  — page background      */
  --color-kanagawa-sidebar: #0d0c0c; /* Dragon Black 0 — sidebar, depth       */
  --color-kanagawa-text: #c5c9c5; /* Dragon White  — body copy            */
  --color-kanagawa-muted: #737c73; /* Dragon Ash    — secondary / captions  */
  --color-kanagawa-accent: #658594; /* Dragon Blue   — links, interactive   */
  --color-kanagawa-gold: #c4b28a; /* Dragon Yellow — headings, emphasis   */
  --color-kanagawa-wave: #223249; /* Wave Blue 1   — borders, rules       */
}
</file>

