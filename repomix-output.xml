  }

  /* ----- Actions ----- */
  .challenge-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding: 1rem 1.5rem 0.5rem 1.5rem;
  }

  /* ----- Recruiter bypass (terminal easter-egg) ----- */
  .challenge-bypass {
