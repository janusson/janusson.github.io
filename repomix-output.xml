<file path="src/components/Sidebar.astro">
---
const navItems = [
  { label: "Home", href: "/" },
  { label: "Posts", href: "/posts/" },
  { label: "Projects", href: "/projects/" },
  { label: "Publications", href: "/publications/" },
  { label: "About", href: "/about/" },
  // The CV is the site's primary conversion action — rendered as a
  // distinct filled button rather than a plain nav link.
  { label: "CV", href: "/cv/", variant: "cv" },
  { label: "Contact", href: "/contact/" },
];

const socialLinks = [
  {
    label: "GitHub",
    icon: "fa-brands fa-github",
    url: "https://github.com/janusson",
  },
  {
    label: "LinkedIn",
    icon: "fa-brands fa-linkedin",
    url: "https://www.linkedin.com/in/eric-janusson",
  },
  {
    label: "Google Scholar",
    icon: "fa-solid fa-graduation-cap",
    url: "https://scholar.google.com/citations?user=PaUrfcQAAAAJ&hl=en",
  },
  {
    label: "ORCID",
    icon: "fa-brands fa-orcid",
    url: "https://orcid.org/0000-0002-3207-7067",
  },
];

const currentPath = Astro.url?.pathname ?? "/";
---

<!-- ═══ Mobile hamburger (hidden on desktop) ═══
     Rendered as a sibling of <aside> so it stays pinned to the viewport
     while the drawer itself is translated off-canvas. -->
<button
  class="sidebar-menu-toggle"
  aria-expanded="false"
  aria-controls="sidebar"
  aria-label="Toggle navigation menu"
  type="button"
>
  <span class="hamburger-box">
    <span class="hamburger-inner"></span>
  </span>
</button>

<!-- ═══ Sidebar: fixed left rail on desktop, off-canvas drawer on mobile ═══ -->
<aside class="sidebar" id="sidebar" tabindex="-1">
  <div class="sidebar-inner">
    <!-- Navigation -->
    <nav class="sidebar-nav" aria-label="Main navigation">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "sidebar-nav-link",
                  {
                    "sidebar-nav-link--active": currentPath === item.href,
                    "sidebar-nav-link--cv": item.variant === "cv",
                  },
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Social Links -->
    <div class="sidebar-social">
      {
        socialLinks.map((link) => (
          <a
            href={link.url}
            class="sidebar-social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.label}
            title={link.label}
          >
            <i class={link.icon} />
          </a>
        ))
      }
    </div>

    <!-- Theme switcher UNDER CONSTRUCTION — see BaseLayout for palette blocks -->
  </div>
</aside>

<!-- ═══ Mobile dimming overlay ═══ -->
<div class="sidebar-backdrop" aria-hidden="true"></div>

<style>
  /* ═══════════════════════════════════════════════
       Desktop sidebar (fixed left rail)
       ═══════════════════════════════════════════════ */

  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-width);
    height: 100vh;
    height: 100dvh;
    background: var(--color-sidebar);
    color: var(--color-sidebar-text);
    overflow-y: auto;
    z-index: 100;
    display: flex;
    flex-direction: column;
    /* Subtle blue-tinted right edge separating the rail from content */
    border-right: 1px solid rgba(101, 133, 148, 0.18);
  }

  .sidebar-inner {
    display: flex;
    flex-direction: column;
    padding: 2rem 1.5rem;
    height: 100%;
  }

  .sidebar-nav {
    flex: 1;
  }

  .sidebar-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-nav li {
    margin-bottom: 0.15rem;
  }

  .sidebar-nav-link {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    color: var(--color-sidebar-muted);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
  }

  .sidebar-nav-link:hover {
    background: rgba(101, 133, 148, 0.1);
    color: var(--color-sidebar-text);
    text-decoration: none;
    transform: translateX(4px);
  }

  .sidebar-nav-link--active {
    background: rgba(101, 133, 148, 0.15);
    color: var(--color-accent);
    font-weight: 600;
  }

  .sidebar-nav-link--active::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 60%;
    background: var(--color-accent);
    border-radius: 0 2px 2px 0;
  }

  .sidebar-social {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(34, 50, 73, 0.4);
  }

  .sidebar-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: var(--color-sidebar-muted);
    font-size: 1rem;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .sidebar-social-link:hover {
    background: rgba(101, 133, 148, 0.15);
    color: var(--color-accent);
    text-decoration: none;
    box-shadow: 0 0 12px rgba(101, 133, 148, 0.25);
  }

  /* ── Theme controls (UNDER CONSTRUCTION) ── */
  /*
    .sidebar-theme { ... }
    .sidebar-theme-icon { ... }
    .sidebar-theme-palette { ... }
    .sidebar-theme-mode { ... }
    */

  /* ── Mobile-only chrome: hidden on desktop ── */
  .sidebar-menu-toggle {
    display: none;
  }

  .sidebar-backdrop {
    display: none;
  }

  /* Hamburger icon (base styles; the button is only visible on mobile) */
  .hamburger-box {
    position: relative;
    display: block;
    width: 22px;
    height: 16px;
  }

  .hamburger-inner {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition:
      transform 0.25s ease,
      background 0.15s ease;
    transform: translateY(-50%);
  }

  .hamburger-inner::before,
  .hamburger-inner::after {
    content: "";
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.25s ease;
  }

  .hamburger-inner::before {
    top: -6px;
  }

  .hamburger-inner::after {
    top: 6px;
  }

  /* Open state — animated to ✕ */
  .sidebar-menu-toggle[aria-expanded="true"] .hamburger-inner {
    background: transparent;
  }

  .sidebar-menu-toggle[aria-expanded="true"] .hamburger-inner::before {
    transform: translateY(6px) rotate(45deg);
  }

  .sidebar-menu-toggle[aria-expanded="true"] .hamburger-inner::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ═══════════════════════════════════════════════
       Mobile (≤ 768px) — off-canvas drawer
       ═══════════════════════════════════════════════ */

  @media (max-width: 768px) {
    /* ── Floating hamburger toggle (top left of the viewport) ── */
    .sidebar-menu-toggle {
      position: fixed;
      top: 0.75rem;
      left: 0.75rem;
      z-index: 130;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      padding: 0;
      margin: 0;
      background: var(--color-sidebar);
      border: 1px solid rgba(34, 50, 73, 0.5);
      border-radius: 8px;
      cursor: pointer;
      color: var(--color-accent);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.35);
      flex-shrink: 0;
      -webkit-tap-highlight-color: transparent;
      transition:
        background 0.2s ease,
        color 0.2s ease;
    }

    .sidebar-menu-toggle:hover {
      background: rgba(101, 133, 148, 0.15);
    }

    .sidebar-menu-toggle:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }

    /* ── Drawer: slides in from the left, overlaying the content ── */
    .sidebar {
      width: min(85vw, 300px);
      height: 100vh;
      height: 100dvh;
      z-index: 120;
      transform: translateX(-100%);
      visibility: hidden; /* removes it from the tab order when closed */
      transition:
        transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
        visibility 0s linear 0.3s;
    }

    .sidebar.open {
      transform: translateX(0);
      visibility: visible;
      box-shadow: 8px 0 30px rgba(0, 0, 0, 0.45);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* ── Backdrop ── */
    .sidebar-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 110;
      background: rgba(0, 0, 0, 0.5);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .sidebar-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }

    /* ── Drawer contents ── */
    .sidebar-inner {
      padding: 4.75rem 1rem 1.5rem; /* top clears the floating hamburger */
      height: auto;
      min-height: 100%;
    }

    /* ── Navigation: vertical, touch-friendly ── */
    .sidebar-nav ul {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .sidebar-nav li {
      margin-bottom: 0;
      border-bottom: 1px solid rgba(34, 50, 73, 0.15);
    }

    .sidebar-nav-link {
      font-size: 1rem;
      font-weight: 500;
      padding: 0 1rem;
      min-height: 48px;
      display: flex;
      align-items: center;
      border-radius: 0;
      border-left: 3px solid transparent;
      transition:
        background 0.2s ease,
        color 0.2s ease,
        border-color 0.2s ease;
    }

    .sidebar-nav-link:hover {
      background: rgba(101, 133, 148, 0.1);
      color: var(--color-sidebar-text);
      border-left-color: var(--color-accent);
      transform: none;
    }

    .sidebar-nav-link--active {
      background: rgba(101, 133, 148, 0.12);
      color: var(--color-accent);
      border-left-color: var(--color-accent);
      font-weight: 600;
    }

    .sidebar-nav-link--active::before {
      display: none;
    }

    /* ── Social links — pinned to the bottom of the drawer ── */
    .sidebar-social {
      justify-content: flex-start;
      gap: 0.5rem;
      margin-top: auto;
      padding: 1.25rem 0.25rem 0.5rem;
      border-top: 1px solid rgba(34, 50, 73, 0.4);
    }

    .sidebar-social-link {
      width: 40px;
      height: 40px;
      font-size: 1.1rem;
    }

    /* ── Theme toggle (UNDER CONSTRUCTION) ── */
    /*
        .sidebar-theme {
            padding: 0.25rem 1rem 0.75rem;
            margin-top: 0;
            border-top: none;
            justify-content: flex-start;
            gap: 0.5rem;
        }
        */
  }

  /* ═══════════════════════════════════════════════
       CV — distinct filled button in the nav rail
       (defined after the mobile block so the gold fill
       wins the hover-state cascade in the drawer too)
       ═══════════════════════════════════════════════ */

  .sidebar-nav-link--cv {
    margin-top: 0.6rem;
    background: var(--color-heading);
    color: var(--color-bg);
    text-align: center;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .sidebar-nav-link--cv::before {
    display: none; /* the active-route bar clashes with the filled pill */
  }

  .sidebar-nav-link--cv:hover,
  .sidebar-nav-link--active.sidebar-nav-link--cv {
    background: #d6c499;
    color: var(--color-bg);
    box-shadow: 0 0 18px rgba(196, 178, 138, 0.35);
  }

  @media (max-width: 768px) {
    .sidebar-nav-link--cv {
      margin: 0.75rem 1rem 0.5rem;
      border-radius: 6px;
      border-left: none;
    }
  }

  /* Respect reduced-motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .sidebar,
    .sidebar-backdrop,
    .hamburger-inner,
    .hamburger-inner::before,
    .hamburger-inner::after {
      transition: none;
    }
  }
</style>

<script>
  // ── Mobile off-canvas drawer toggle (vanilla JS, zero dependencies) ──

  const sidebar = document.getElementById("sidebar");
  const toggle = document.querySelector(".sidebar-menu-toggle");
  const backdrop = document.querySelector(".sidebar-backdrop");

  if (!sidebar || !toggle || !backdrop) {
    // Component not present on this page — nothing to do.
  } else {
    const mobileMQ = window.matchMedia("(max-width: 768px)");

    function isOpen(): boolean {
      return sidebar!.classList.contains("open");
    }

    function setOpen(open: boolean): void {
      sidebar!.classList.toggle("open", open);
      backdrop!.classList.toggle("open", open);
      toggle!.setAttribute("aria-expanded", String(open));
      document.body.classList.toggle("menu-open", open);

      // Keep background content out of the tab order while the drawer is open.
      if ("inert" in HTMLElement.prototype) {
        document.querySelector(".main-content")?.toggleAttribute("inert", open);
      }

      if (open) {
        sidebar!.focus();
      } else {
        (toggle as HTMLElement).focus();
      }
    }

    // ── Toggle click ──
    toggle.addEventListener("click", () => setOpen(!isOpen()));

    // ── Backdrop click closes ──
    backdrop.addEventListener("click", () => setOpen(false));

    // ── Close on Escape ──
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) setOpen(false);
    });

    // ── Close when a nav link is tapped (mobile navigation) ──
    sidebar.querySelectorAll(".sidebar-nav-link").forEach((link) => {
      link.addEventListener("click", () => {
        if (mobileMQ.matches && isOpen()) setOpen(false);
      });
    });

    // ── Reset if the viewport expands past the mobile breakpoint ──
    mobileMQ.addEventListener("change", (e) => {
      if (!e.matches) setOpen(false);
    });
  }

  /*
     * Theme controls (palette cycle + dark/light toggle)
     * UNDER CONSTRUCTION  —  re-enable when multi-palette CSS
     * is un-commented in BaseLayout.astro.
     *
    var paletteBtn = document.getElementById("theme-palette-btn");
    ...
    */
</script>
</file>

<file path="src/layouts/BaseLayout.astro">
---
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";

interface PageMeta {
  title: string;
  description?: string;
  image?: string;
}

export interface Props extends PageMeta {
  frontmatter?: PageMeta;
}

const DEFAULT_IMAGE = "/assets/images/Spectral-Similarity-Networking-3-Large.png";

const { title, description, image } = Astro.props.frontmatter || Astro.props;
const pageDescription =
  description || "Mass spectrometry, analytical chemistry, and open-source scientific software.";
const resolvedImage = new URL(
  image || DEFAULT_IMAGE,
  Astro.url || Astro.site || "https://www.ericjanusson.ca",
).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={resolvedImage} />

    <title>{title}</title>

    <!-- ═══════════════════════════════════════════════════════
             Theme switcher  —  UNDER CONSTRUCTION
             Multi-palette (Dragon, One Dark, Gruvbox, Ayu Light, …)
             with dark/light mode toggle.
             ═══════════════════════════════════════════════════ -->
    <!--
        <script is:inline>
            (function () {
                var m = localStorage.getItem("theme-mode") || "dark";
                var p = localStorage.getItem("theme-" + m) || "wave";
                document.documentElement.setAttribute("data-theme-mode", m);
                document.documentElement.setAttribute("data-theme-palette", p);
            })();
        </script>
        -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <style is:global>
      /* ═══════════════════════════════════════════════════════
               Shared tokens (not theme-dependent)
               ═══════════════════════════════════════════════════ */
      :root {
        --sidebar-width: 280px;
        --content-max-width: 48rem; /* ≈ Tailwind max-w-3xl — centered prose column */
        --font-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --font-mono: "JetBrains Mono", "Fira Code", monospace;
      }

      /* ═══════════════════════════════════════════════════════
               Kanagawa Dragon  —  fixed theme
               ═══════════════════════════════════════════════════ */
      :root {
        --color-bg: #181616;
        --color-sidebar: #0d0c0c;
        --color-sidebar-text: #c5c9c5;
        --color-sidebar-muted: #737c73;
        --color-accent: #658594;
        --color-link: #658594;
        --color-link-hover: #8ba4b0;
        --color-text: #c5c9c5;
        --color-heading: #c4b28a;
        --color-border: #223249;
        --color-card-bg: rgba(40, 39, 39, 0.3);
        --color-body: #c8c093;
      }

      /* ═══════════════════════════════════════════════════════
               Multi-palette theme system  —  UNDER CONSTRUCTION

               Dark:  Dragon (default), One Dark, Gruvbox
               Light: Ayu Light (default), One Light, Gruvbox Light

               Enabling: un-comment the blocks below, activate the
               anti-FOUC <script> above, and wire up the sidebar
               theme toggle UI.
               ═══════════════════════════════════════════════════ */

      /*
            [data-theme-mode="dark"][data-theme-palette="onedark"] { ... One Dark palette ... }
            [data-theme-mode="dark"][data-theme-palette="gruvbox"] { ... Gruvbox Dark palette ... }
            [data-theme-mode="light"][data-theme-palette="ayu"] { ... Ayu Light palette ... }
            [data-theme-mode="light"][data-theme-palette="onelight"] { ... One Light palette ... }
            [data-theme-mode="light"][data-theme-palette="gruvbox-light"] { ... Gruvbox Light palette ... }
            */

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      /* Custom Scrollbar */
      ::-webkit-scrollbar {
        width: 10px;
      }
      ::-webkit-scrollbar-track {
        background: var(--color-bg);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--color-border);
        border-radius: 5px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--color-accent);
      }

      html {
        font-size: 16px;
        scroll-behavior: smooth;
        /* Solid root canvas behind the translucent body layer, so no
           browser-default white bleeds through anywhere. */
        background: var(--color-bg);
      }

      body {
        font-family: var(--font-sans);
        /* Frosted-glass layer: translucent so the SpectralNetwork canvas
           reads through. NOTE: intentionally NO backdrop-filter on <body> —
           a filter here would make <body> the containing block for fixed
           descendants (SpectralNetwork, Sidebar) and break their viewport
           anchoring. The blur lives on the content containers instead. */
        background: rgba(24, 22, 22, 0.85);
        color: var(--color-text);
        line-height: 1.7;
        display: flex;
        min-height: 100vh;
      }

      /* Scroll lock while the mobile nav drawer is open */
      body.menu-open {
        overflow: hidden;
      }

      a {
        color: var(--color-link);
        text-decoration: none;
        transition:
          color 0.2s ease,
          text-shadow 0.2s ease;
      }

      a:hover {
        color: var(--color-link-hover);
        text-shadow: 0 0 8px rgba(101, 133, 148, 0.4);
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        color: var(--color-heading);
        font-weight: 700;
        line-height: 1.3;
        margin-top: 1.5em;
        margin-bottom: 0.5em;
        letter-spacing: -0.02em;
      }

      h1 {
        font-size: 2.2rem;
        margin-top: 0;
      }
      h2 {
        font-size: 1.6rem;
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 0.3em;
      }
      h3 {
        font-size: 1.3rem;
      }

      p {
        margin-bottom: 1em;
        color: var(--color-body);
      }

      ul,
      ol {
        margin-bottom: 1em;
        padding-left: 1.5em;
        color: var(--color-body);
      }
      li {
        margin-bottom: 0.4em;
      }

      blockquote {
        border-left: 4px solid var(--color-accent);
        padding: 0.8em 1.2em;
        margin: 1.5em 0;
        color: var(--color-body);
        background: var(--color-card-bg);
        border-radius: 0 8px 8px 0;
        font-style: italic;
      }

      code {
        font-family: var(--font-mono);
        font-size: 0.9em;
        background: var(--color-card-bg);
        color: var(--color-heading);
        padding: 0.2em 0.4em;
        border-radius: 4px;
      }

      pre {
        background: var(--color-sidebar);
        border: 1px solid var(--color-border);
        box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.15);
        padding: 1.2em;
        border-radius: 8px;
        overflow-x: auto;
        margin-bottom: 1.5em;
      }

      pre code {
        background: none;
        padding: 0;
        color: var(--color-text);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1.5em;
        font-size: 0.95rem;
      }

      th,
      td {
        border: 1px solid var(--color-border);
        padding: 0.8em 1em;
        text-align: left;
      }

      th {
        background: var(--color-card-bg);
        color: var(--color-heading);
        font-weight: 600;
      }

      img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
      }

      hr {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 2.5em 0;
      }

      /* Layout */
      .page-wrapper {
        display: flex;
        width: 100%;
        min-height: 100vh;
      }

      /* Region right of the fixed sidebar; the inner column centers itself.
         position: relative anchors page-level background layers (e.g. the
         homepage SpectralNetwork) that pages inject via the background slot. */
      .main-content {
        position: relative;
        flex: 1;
        min-width: 0; /* let wide children (tables, <pre>) shrink instead of overflowing */
        margin-left: var(--sidebar-width);
        padding: 3rem clamp(1.5rem, 5vw, 5rem) 4rem;
      }

      /* Centered content column — balanced whitespace on widescreens */
      .content-container {
        max-width: var(--content-max-width);
        margin-inline: auto;
      }

      /* Buttons */
      .btn {
        display: inline-block;
        padding: 0.6em 1.4em;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        text-decoration: none;
      }

      .btn--primary {
        background: transparent;
        color: var(--color-accent);
        border: 1px solid var(--color-accent);
        box-shadow: 0 0 10px rgba(101, 133, 148, 0.1);
      }

      .btn--primary:hover {
        background: var(--color-accent);
        color: var(--color-bg);
        box-shadow: 0 0 20px rgba(101, 133, 148, 0.4);
        text-decoration: none;
      }

      .btn--large {
        padding: 0.85em 2em;
        font-size: 1rem;
      }

      /* CV — dedicated, distinct CTA: solid cream/gold fill instead of the
         accent-outlined primary style, so it reads as the site's main
         conversion action at a glance. */
      .btn--cv {
        background: var(--color-heading);
        color: var(--color-bg);
        border: 1px solid var(--color-heading);
        box-shadow: 0 0 16px rgba(196, 178, 138, 0.22);
      }

      .btn--cv:hover {
        background: #d6c499;
        border-color: #d6c499;
        color: var(--color-bg);
        text-decoration: none;
        box-shadow: 0 0 26px rgba(196, 178, 138, 0.45);
        filter: brightness(1.05);
      }

      /* Blog Post Cards */
      .post-card {
        position: relative;
        z-index: 1; /* above the SpectralNetwork canvas (z-index: 0) */
        padding: 1.5em;
        background: rgba(40, 39, 39, 0.15);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          border-color 0.2s ease;
        margin-bottom: 1.5em;
      }

      .post-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
        border-color: var(--color-accent);
      }

      .post-card h2 {
        margin-top: 0;
        border-bottom: none;
        padding-bottom: 0;
        font-size: 1.4rem;
      }

      .post-card h2 a {
        color: var(--color-accent);
      }

      .post-card h2 a:hover {
        text-shadow: none;
      }

      .post-meta {
        font-size: 0.85rem;
        color: var(--color-sidebar-muted);
        margin-bottom: 0.8em;
        font-family: var(--font-mono);
      }

      .post-tags {
        margin-top: 0.8em;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5em;
      }

      .post-tag {
        display: inline-block;
        background: var(--color-card-bg);
        color: var(--color-accent);
        border: 1px solid var(--color-border);
        padding: 0.2em 0.8em;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
        transition: all 0.2s ease;
      }

      .post-tag:hover {
        background: var(--color-accent);
        color: var(--color-bg);
      }

      /* Compact inline metadata chips (featured project cards, tech lists) */
      .chip {
        display: inline-flex;
        align-items: baseline;
        gap: 0.45em;
        padding: 0.2em 0.75em;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        background: rgba(101, 133, 148, 0.08);
        color: var(--color-text);
        font-family: var(--font-mono);
        font-size: 0.78rem;
        line-height: 1.5;
        white-space: nowrap;
      }

      .chip-label {
        font-size: 0.66rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-accent);
      }

      .chip--tech {
        color: var(--color-accent);
      }

      /* Section eyebrow — small uppercase kicker above headings */
      .eyebrow {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin: 0 0 0.9em;
      }

      /* Subtle radial vignette behind text blocks sitting over the
         animated background — darkens the center so copy stays legible
         while the network fades out at the edges. */
      .vignette {
        background: radial-gradient(
          ellipse 110% 95% at 50% 35%,
          rgba(13, 12, 12, 0.5) 0%,
          rgba(13, 12, 12, 0.28) 55%,
          transparent 82%
        );
      }

      /* Mermaid diagrams */
      .mermaid-container {
        margin: 2em 0;
        overflow-x: auto;
        display: flex;
        justify-content: center;
      }

      .mermaid-container svg {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
      }

      @media (max-width: 768px) {
        .main-content {
          margin-left: 0;
          /* Top padding clears the floating hamburger button */
          padding: 4.5rem 1.25rem 3rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="page-wrapper">
      <Sidebar />
      <main class="main-content">
        <slot name="background" />
        <div class="content-container">
          <slot />
        </div>
      </main>
    </div>

    <!-- Mermaid diagram rendering -->
    <script type="module" is:inline>
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs";
      mermaid.initialize({
        startOnLoad: false,
        theme: "dark",
        securityLevel: "loose",
      });

      async function renderMermaidDiagrams() {
        const blocks = document.querySelectorAll(
          'pre[data-language="mermaid"], pre:has(code.language-mermaid), pre.mermaid, div.mermaid',
        );
        for (const el of blocks) {
          if (el.hasAttribute("data-mermaid-rendered")) continue;
          el.setAttribute("data-mermaid-rendered", "true");

          // Extract raw diagram text from <code> child if present,
          // otherwise fall back to the element's own textContent.
          const codeEl = el.querySelector("code.language-mermaid");
          const source = codeEl ? codeEl.textContent || "" : el.textContent || "";

          const id = "mermaid-" + Math.random().toString(36).substring(2, 9);
          try {
            const { svg } = await mermaid.render(id, source);
            const container = document.createElement("div");
            container.className = "mermaid-container";
            container.innerHTML = svg;
            el.replaceWith(container);
          } catch (err) {
            console.error("Mermaid render failed:", err);
          }
        }
      }

      renderMermaidDiagrams();
    </script>
  </body>
</html>
</file>

