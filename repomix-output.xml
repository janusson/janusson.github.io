<file path="src/pages/posts.astro">
---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Extract all unique tags from the blog collection
const allTags = Array.from(new Set(sortedPosts.flatMap((post) => post.data.tags))).sort();
---

<BaseLayout
  title="Posts"
  description="Technical posts on mass spectrometry, analytical chemistry, and scientific computing."
>
  <h1>Posts</h1>
  <p style="color: var(--color-sidebar-muted); margin-bottom: 2em;">
    Deep dives into LC-MS workflows, laboratory automation, data analytics, quantitative finance,
    audio signal processing, and open-source scientific tooling.
  </p>

  <!-- Search UI -->
  <div id="search-container">
    <div class="search-input-wrapper">
      <svg
        class="search-icon"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="search" id="search-input" placeholder="Search posts..." autocomplete="off" />
      <button id="search-clear" type="button" aria-label="Clear search" style="display: none;">
        &times;
      </button>
    </div>
    <p id="search-fallback" style="display: none;">
      Full-text search is active in production builds.
    </p>
    <div id="search-results" style="display: none;"></div>
  </div>

  <!-- Tag Filter UI -->
  {
    allTags.length > 0 && (
      <div id="tag-filters" style="margin-bottom: 2em;">
        <button
          class="post-tag tag-filter-btn tag-filter-btn--active"
          data-tag="all"
          style="margin-right: 0.5em; margin-bottom: 0.5em; cursor: pointer;"
        >
          All
        </button>
        {allTags.map((tag) => (
          <button
            class="post-tag tag-filter-btn"
            data-tag={tag}
            style="margin-right: 0.5em; margin-bottom: 0.5em; cursor: pointer;"
          >
            {tag}
          </button>
        ))}
      </div>
    )
  }

  <!-- Post List -->
  <div id="post-list">
    {
      sortedPosts.map((post) => (
        <article class="post-card" data-tags={post.data.tags.join(",")}>
          <h2>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </h2>
          <p class="post-meta">
            {post.data.date.toLocaleDateString("en-CA", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </p>
          {post.data.description && <p>{post.data.description}</p>}
          {post.data.tags.length > 0 && (
            <div class="post-tags">
              {post.data.tags.map((tag) => (
                <span class="post-tag">{tag}</span>
              ))}
            </div>
          )}
        </article>
      ))
    }
  </div>
</BaseLayout>

<style>
  .tag-filter-btn--active {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .post-card--hidden {
    display: none;
  }

  /* ── Search UI ── */
  #search-container {
    margin-bottom: 2em;
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 480px;
  }

  .search-icon {
    position: absolute;
    left: 0.75em;
    color: var(--color-sidebar-muted);
    pointer-events: none;
  }

  #search-input {
    width: 100%;
    padding: 0.6em 1em 0.6em 2.5em;
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    transition: border-color 0.2s ease;
    box-sizing: border-box;
  }

  #search-input:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  #search-input::placeholder {
    color: var(--color-sidebar-muted);
  }

  /* Clear the default Safari/webkit search cancel button */
  #search-input::-webkit-search-decoration,
  #search-input::-webkit-search-cancel-button,
  #search-input::-webkit-search-results-button,
  #search-input::-webkit-search-results-decoration {
    display: none;
  }

  #search-clear {
    position: absolute;
    right: 0.5em;
    background: none;
    border: none;
    color: var(--color-sidebar-muted);
    font-size: 1.25rem;
    cursor: pointer;
    padding: 0.25em 0.5em;
    line-height: 1;
  }

  #search-clear:hover {
    color: var(--color-text);
  }

  #search-fallback {
    margin-top: 0.5em;
    color: var(--color-sidebar-muted);
    font-size: 0.85rem;
    font-style: italic;
  }

  /* ── Search Results ── */
  .search-result {
    padding: 1em 1.2em;
    margin-bottom: 0.75em;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-card-bg);
    transition: border-color 0.2s ease;
  }

  .search-result:hover {
    border-color: var(--color-accent);
  }

  .search-result h3 {
    margin: 0 0 0.25em 0;
    font-size: 1.05rem;
  }

  .search-result h3 a {
    color: var(--color-link);
    text-decoration: none;
  }

  .search-result h3 a:hover {
    color: var(--color-link-hover);
    text-decoration: underline;
  }

  .search-result-meta {
    font-size: 0.8rem;
    color: var(--color-sidebar-muted);
    margin-bottom: 0.5em;
  }

  .search-result-excerpt {
    font-size: 0.9rem;
    color: var(--color-body);
    line-height: 1.55;
  }

  .search-result-excerpt mark {
    background: rgba(101, 133, 148, 0.25);
    color: var(--color-text);
    padding: 0.1em 0.2em;
    border-radius: 2px;
  }

  .search-result-tags {
    margin-top: 0.5em;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
  }

  .search-result-tags .post-tag {
    font-size: 0.7rem;
  }

  .search-empty {
    color: var(--color-sidebar-muted);
    font-style: italic;
    padding: 1em 0;
  }
</style>

<script>
  // ── Tag filtering (preserved) ──
  function initTagFilters() {
    const filterButtons = document.querySelectorAll(".tag-filter-btn");
    const postCards = document.querySelectorAll("#post-list .post-card");

    function setActiveButton(activeBtn: Element) {
      filterButtons.forEach((btn) => btn.classList.remove("tag-filter-btn--active"));
      activeBtn.classList.add("tag-filter-btn--active");
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const selectedTag = btn.getAttribute("data-tag");
        setActiveButton(btn);

        postCards.forEach((card) => {
          const cardTags = (card.getAttribute("data-tags") ?? "").split(",");
          if (selectedTag === "all" || cardTags.includes(selectedTag ?? "")) {
            card.classList.remove("post-card--hidden");
          } else {
            card.classList.add("post-card--hidden");
          }
        });
      });
    });
  }

  // ── Full-text search with Pagefind ──
  function initSearch() {
    const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
    const searchClear = document.getElementById("search-clear");
    const searchResults = document.getElementById("search-results");
    const postList = document.getElementById("post-list");
    const tagFilters = document.getElementById("tag-filters");

    if (!searchInput || !searchResults || !postList) return;

    let pagefind: any = null;
    let debounceTimer: ReturnType<typeof setTimeout> | null = null;

    // ── Try to load Pagefind (via script tag to bypass bundler) ──
    async function loadPagefind(): Promise<boolean> {
      if (pagefind) return true;

      // If already loaded by another mechanism
      if ((window as any).Pagefind) {
        pagefind = (window as any).Pagefind;
        return true;
      }

      return new Promise((resolve) => {
        const script = document.createElement("script");
        script.src = "/pagefind/pagefind.js";
        script.onload = () => {
          pagefind = (window as any).Pagefind;
          resolve(pagefind != null);
        };
        script.onerror = () => resolve(false);
        document.head.appendChild(script);
      });
    }

    // ── Show / hide views ──
    function showSearchResults() {
      if (postList) postList.style.display = "none";
      if (tagFilters) tagFilters.style.display = "none";
      if (searchResults) searchResults.style.display = "";
    }

    function showPostList() {
      if (postList) postList.style.display = "";
      if (tagFilters) tagFilters.style.display = "";
      if (searchResults) {
        searchResults.style.display = "none";
        searchResults.innerHTML = "";
      }
    }

    // ── Render a single search result ──
    function renderResult(data: {
      url: string;
      excerpt: string;
      meta: Record<string, string>;
    }): string {
      const title = data.meta?.title ?? data.url;
      const date = data.meta?.date ?? "";
      const tagsRaw = data.meta?.tags ?? "";
      const tags = tagsRaw ? tagsRaw.split(/,\s*/).filter(Boolean) : [];

      return `
                <div class="search-result">
                    <h3><a href="${data.url}">${title}</a></h3>
                    ${date ? `<div class="search-result-meta">${date}</div>` : ""}
                    <div class="search-result-excerpt">${data.excerpt}</div>
                    ${tags.length > 0 ? `<div class="search-result-tags">${tags.map((t: string) => `<span class="post-tag">${t}</span>`).join("")}</div>` : ""}
                </div>
            `;
    }

    // ── Perform search ──
    async function doSearch(query: string) {
      if (!searchResults) return;

      if (!query.trim()) {
        showPostList();
        if (searchClear) searchClear.style.display = "none";
        return;
      }

      if (searchClear) searchClear.style.display = "";

      const loaded = await loadPagefind();
      if (!loaded) {
        showSearchResults();
        searchResults.innerHTML =
          '<p class="search-empty">Full-text search is active in production builds. Run <code>npm run build</code> locally to enable.</p>';
        return;
      }

      const search = await pagefind.search(query);
      if (!search || !search.results.length) {
        showSearchResults();
        searchResults.innerHTML = `<p class="search-empty">No results for &ldquo;${query}&rdquo;.</p>`;
        return;
      }

      const results = await Promise.all(search.results.map((r: any) => r.data()));

      showSearchResults();
      searchResults.innerHTML = results.map(renderResult).join("");
    }

    // ── Event handlers ──
    searchInput.addEventListener("input", () => {
      const query = searchInput.value;

      // Debounce: wait 300ms after last keystroke
      if (debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => doSearch(query), 300);
    });

    if (searchClear) {
      searchClear.addEventListener("click", () => {
        searchInput.value = "";
        searchClear.style.display = "none";
        showPostList();
        searchInput.focus();
      });
    }

    // Handle browser-native clear (e.g., in some browsers)
    searchInput.addEventListener("search", () => {
      if (!searchInput.value) {
        if (searchClear) searchClear.style.display = "none";
        showPostList();
      }
    });

    // Preload Pagefind on idle so first search is fast
    if ("requestIdleCallback" in window) {
      (window as any).requestIdleCallback(loadPagefind);
    } else {
      setTimeout(loadPagefind, 500);
    }
  }

  // ── Bootstrap ──
  document.addEventListener("DOMContentLoaded", () => {
    initTagFilters();
    initSearch();
  });
</script>
</file>

<file path="src/pages/index.astro">
---
import BaseLayout from "../layouts/BaseLayout.astro";
import SpectralNetwork from "../components/Visualizations/SpectralNetwork.astro";
import FeaturedProjectCard from "../components/FeaturedProjectCard.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import { featuredProjects, projects, domains, contactLinks } from "../data/projects";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const featuredPosts = posts.slice(0, 3);
const hasMorePosts = posts.length > 3;
---

<BaseLayout
  title="Eric Janusson — Analytical Chemistry × Scientific Software"
  description="Eric Janusson is an analytical chemist and scientific software developer building open-source tools — MassFlow, MSMCP — for mass spectrometry."
>
  <!-- Animated background: anchored to the top of the page so it scrolls
       away with the content; the IntersectionObserver inside the component
       pauses the simulation once it's out of view. -->
  <div class="home-background" slot="background" aria-hidden="true">
    <SpectralNetwork />
  </div>

  <!-- ═══ Hero ═══ -->
  <section class="hero">
    <p class="eyebrow">Mass Spectrometry · Scientific Software · Open Science</p>
    <h1 class="hero-title">Analytical Chemistry × Scientific Software</h1>
    <p class="hero-tagline">
      I'm <strong class="hero-name">Eric Janusson</strong> — a PhD analytical chemist and scientific software
      developer. After a decade on the bench in academic and regulated labs, I now build open-source tools
      that turn messy mass spectrometry data into reproducible, lab-grade workflows.
    </p>
    <div class="hero-actions">
      <a href="/projects/" class="btn btn--primary btn--large"
        >See All Projects <span aria-hidden="true">&rarr;</span></a
      >
      <a href="/cv/" class="btn btn--cv btn--large"
        >View CV <span aria-hidden="true">&rarr;</span></a
      >
      <a href="/about/" class="hero-textlink"
        >More about me <span aria-hidden="true">&rarr;</span></a
      >
    </div>
  </section>

  <!-- ═══ Featured Work ═══ -->
  <section class="home-section vignette" id="featured">
    <header class="section-head">
      <p class="eyebrow">Featured Work</p>
      <h2>Open-source tools for mass spectrometry</h2>
    </header>
    <div class="featured-grid">
      {featuredProjects.map((project) => <FeaturedProjectCard project={project} />)}
    </div>
  </section>

  <!-- ═══ What I Work On ═══ -->
  <section class="home-section vignette" id="domains">
    <header class="section-head">
      <p class="eyebrow">What I Work On</p>
      <h2>Bench science meets software engineering</h2>
    </header>
    <div class="domain-grid">
      {
        domains.map((domain) => (
          <div class="domain">
            <i class:list={["domain-icon", domain.icon]} aria-hidden="true" />
            <h3>{domain.title}</h3>
            <p>{domain.blurb}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ═══ Selected Projects (mini case studies) ═══ -->
  <section class="home-section" id="projects">
    <header class="section-head">
      <p class="eyebrow">Selected Projects</p>
      <h2>Mini case studies</h2>
    </header>
    <div class="case-list">
      {projects.map((project) => <CaseStudyCard project={project} />)}
    </div>
    <p class="view-all">
      <a href="/projects/" class="btn btn--primary"
        >See All Projects <span aria-hidden="true">&rarr;</span></a
      >
    </p>
  </section>

  <!-- ═══ Selected Writing ═══ -->
  <section class="home-section" id="writing">
    <header class="section-head">
      <p class="eyebrow">Selected Writing</p>
      <h2>Notes from the lab and the terminal</h2>
    </header>

    {
      featuredPosts.map((post) => (
        <article class="post-card">
          <h2>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </h2>
          <p class="post-meta">
            {post.data.date.toLocaleDateString("en-CA", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </p>
          {post.data.description && <p>{post.data.description}</p>}
          {post.data.tags.length > 0 && (
            <div class="post-tags">
              {post.data.tags.slice(0, 3).map((tag) => (
                <span class="post-tag">{tag}</span>
              ))}
            </div>
          )}
        </article>
      ))
    }

    {
      hasMorePosts && (
        <p class="view-all">
          <a href="/posts/" class="btn btn--primary">
            View all posts <span aria-hidden="true">&rarr;</span>
          </a>
        </p>
      )
    }
  </section>

  <!-- ═══ About ═══ -->
  <section class="home-section" id="about">
    <header class="section-head">
      <p class="eyebrow">About</p>
      <h2>From the bench to the terminal</h2>
    </header>
    <p class="about-blurb">
      Over a decade of chemical analytics — electrospray ionization fundamentals, ISO/IEC 17025
      laboratories, ultra-high-purity isotope production — followed by a move into full-time
      scientific software. I care about reproducibility, validation, and tools built for the long
      haul.
    </p>
    <p class="view-all">
      <a href="/about/" class="btn btn--primary"
        >More about me <span aria-hidden="true">&rarr;</span></a
      >
    </p>
  </section>

  <!-- ═══ CV & Contact ═══ -->
  <section class="home-section home-contact" id="contact">
    <header class="section-head">
      <p class="eyebrow">CV & Contact</p>
      <h2>Let's work together</h2>
    </header>
    <p class="contact-intro">
      Consulting, speaking, research collaborations, or questions about my open-source tools — the
      fastest ways to reach me:
    </p>
    <div class="contact-actions">
      <a href="/cv/" class="btn btn--cv btn--large"
        >View CV <span aria-hidden="true">&rarr;</span></a
      >
    </div>
    <ul class="contact-links">
      {
        contactLinks.map((link) => (
          <li>
            <a
              class="contact-link"
              href={link.href}
              target={link.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
            >
              <i class:list={[link.icon]} aria-hidden="true" />
              <span class="contact-link-label">{link.label}</span>
              <span class="contact-link-value">{link.value}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  /* Wider column on the homepage for the grid layouts (prose pages keep
     the 48rem default). */
  :global(.content-container) {
    max-width: 62rem;
  }

  /* ── Background layer ── */
  .home-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    z-index: 1; /* above the SpectralNetwork layer (z-index: 0) */
    padding: 3.5rem 1.25rem 2.5rem;
    background: linear-gradient(to right, rgba(24, 22, 22, 0.55) 0%, transparent 100%);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  .hero-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-heading);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 0.45em;
    text-shadow: 0 0 40px rgba(196, 178, 138, 0.15);
  }

  .hero-tagline {
    max-width: 36em;
    font-size: 1.05rem;
    color: var(--color-text);
    opacity: 0.8;
    line-height: 1.75;
    margin: 0 0 1.6em;
  }

  .hero-name {
    color: var(--color-heading);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8em;
  }

  .hero-textlink {
    font-weight: 600;
    font-size: 0.95rem;
  }

  /* ── Sections ── */
  .home-section {
    position: relative;
    z-index: 1;
    padding: 2.75rem 0 0.75rem;
  }

  .section-head h2 {
    margin-top: 0;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.45em;
    font-size: 1.45rem;
  }

  /* ── Featured grid ── */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  /* ── Domain grid ── */
  .domain-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 0.9rem;
  }

  .domain {
    position: relative;
    z-index: 1;
    padding: 1em 1.1em;
    background: rgba(40, 39, 39, 0.28);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .domain:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
  }

  .domain-icon {
    color: var(--color-heading);
    font-size: 1.05rem;
    opacity: 0.9;
  }

  .domain h3 {
    margin: 0.5em 0 0.3em;
    font-size: 1rem;
  }

  .domain p {
    margin: 0;
    font-size: 0.88rem;
    opacity: 0.8;
    line-height: 1.6;
  }

  /* ── Case studies ── */
  .case-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .view-all {
    margin: 2em 0 0;
    text-align: center;
  }

  /* ── About ── */
  .about-blurb {
    max-width: 42em;
    font-size: 1rem;
    line-height: 1.75;
    margin-bottom: 1.5em;
  }

  /* ── CV & Contact ── */
  .home-contact {
    padding-bottom: 3rem;
  }

  .contact-intro {
    max-width: 40em;
    margin-bottom: 1.5em;
  }

  .contact-actions {
    margin-bottom: 1.75em;
  }

  .contact-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
  }

  .contact-link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8em;
    padding: 0.7em 1em;
    background: rgba(40, 39, 39, 0.28);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .contact-link:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
    color: var(--color-link-hover);
    text-shadow: none;
  }

  .contact-link i {
    color: var(--color-heading);
    width: 1.2em;
    text-align: center;
  }

  .contact-link-label {
    min-width: 5.5em;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .contact-link-value {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    opacity: 0.85;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2.5rem 0.25rem 2rem;
      background: transparent;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-actions .btn {
      text-align: center;
    }

    .hero-textlink {
      text-align: center;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }

    .contact-link-value {
      margin-left: 0;
      flex-basis: 100%;
      padding-left: 2em;
    }
  }
</style>
