<file path="src/components/Visualizations/SpectralNetwork.astro">
---
// SpectralNetwork.astro  -  D3.js force-directed network graph
// Inspired by mass spectrometry spectral similarity networks.
// Renders as a viewport-sized background layer. The host page positions it
// (the homepage anchors it behind the hero so it scrolls away with the page),
// and the IntersectionObserver below pauses the simulation whenever the
// layer is scrolled out of view.
---

<div id="spectral-network" aria-hidden="true"></div>

<style>
  #spectral-network {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Deliberately subtle: the network sits behind frosted content panels,
       so ~30% container opacity keeps it readable as texture without
       competing with the text (also lowers GPU/CPU load). */
    opacity: 0.3;
  }

  #spectral-network svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Allow pointer events on interactive elements */
  #spectral-network svg circle,
  #spectral-network svg line {
    pointer-events: auto;
  }

  /* ── Simulation toggle button (Kanagawa palette) ── */
  .sn-toggle {
    position: fixed;
    bottom: 1.75rem;
    right: 1.75rem;
    z-index: 100;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1.5px solid var(--color-border, #223249);
    background: rgba(24, 22, 22, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(8px) scale(0.95);
    transition:
      opacity 0.35s ease,
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      border-color 0.3s ease,
      box-shadow 0.3s ease;
    pointer-events: auto;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .sn-toggle.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .sn-toggle:hover {
    border-color: var(--color-accent, #658594);
    box-shadow:
      0 2px 16px rgba(0, 0, 0, 0.45),
      0 0 18px rgba(101, 133, 148, 0.18);
  }

  .sn-toggle:active {
    transform: scale(0.92);
  }

  /* Auto-paused indicator: subtle ring pulse */
  .sn-toggle.auto-paused {
    border-style: dashed;
    animation: sn-pulse 2.2s ease-in-out infinite;
  }

  @keyframes sn-pulse {
    0%,
    100% {
      border-color: var(--color-border, #223249);
    }
    50% {
      border-color: var(--color-accent, #658594);
    }
  }

  .sn-toggle svg {
    width: 18px;
    height: 18px;
    fill: var(--color-accent, #658594);
    transition: transform 0.25s ease;
    pointer-events: none;
  }
</style>

<script>
  import * as d3 from "d3";

  interface SpectralNode extends d3.SimulationNodeDatum {
    id: number;
    group: number;
    r: number;
  }

  interface SpectralLink extends d3.SimulationLinkDatum<SpectralNode> {
    source: number | SpectralNode;
    target: number | SpectralNode;
  }

  function initSpectralNetwork() {
    const container = document.getElementById("spectral-network");
    if (!container) return;

    let W = window.innerWidth;
    let H = window.innerHeight;

    // ═══════════════════════════════════════════════
    //  Pause / Resume state machine
    // ═══════════════════════════════════════════════

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let userPaused = prefersReducedMotion; // toggled by button
    let outOfView = false; // set by IntersectionObserver
    let tabHidden = document.hidden; // set by visibilitychange

    function effectivePaused(): boolean {
      return userPaused || outOfView || tabHidden;
    }

    function applyPauseState(): void {
      if (effectivePaused()) {
        simulation.stop();
      } else {
        simulation.alpha(0.15).restart();
      }
      updateToggleIcon();
    }

    // ═══════════════════════════════════════════════
    //  Floating toggle button (Kanagawa palette)
    // ═══════════════════════════════════════════════

    const toggleBtn = document.createElement("button");
    toggleBtn.className = "sn-toggle";
    toggleBtn.setAttribute("aria-label", "Pause network simulation");
    toggleBtn.title = "Pause simulation";
    document.body.appendChild(toggleBtn);

    // Fade in after a short delay so it does not flash on load
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        toggleBtn.classList.add("visible");
      });
    });

    // SVG icons (pause = two bars, play = triangle)
    const iconPause =
      '<svg viewBox="0 0 24 24"><rect x="5" y="4" width="5" height="16" rx="1"/><rect x="14" y="4" width="5" height="16" rx="1"/></svg>';
    const iconPlay = '<svg viewBox="0 0 24 24"><polygon points="7,4 20,12 7,20"/></svg>';

    function updateToggleIcon(): void {
      const paused = effectivePaused();
      toggleBtn.innerHTML = paused ? iconPlay : iconPause;
      toggleBtn.setAttribute(
        "aria-label",
        paused ? "Resume network simulation" : "Pause network simulation",
      );
      toggleBtn.title = paused ? "Resume simulation" : "Pause simulation";

      // Dashed-ring indicator when auto-paused but user wants it running
      if (outOfView || tabHidden) {
        toggleBtn.classList.add("auto-paused");
      } else {
        toggleBtn.classList.remove("auto-paused");
      }
    }

    toggleBtn.addEventListener("click", () => {
      userPaused = !userPaused;
      applyPauseState();
    });

    // ═══════════════════════════════════════════════
    //  SVG setup
    // ═══════════════════════════════════════════════

    const svg = d3.select(container).append("svg").attr("width", W).attr("height", H);

    const defs = svg.append("defs");

    // Glow filter for hovered nodes
    const filter = defs
      .append("filter")
      .attr("id", "node-glow")
      .attr("x", "-50%")
      .attr("y", "-50%")
      .attr("width", "200%")
      .attr("height", "200%");
    filter.append("feGaussianBlur").attr("stdDeviation", "3").attr("result", "blur");
    filter
      .append("feMerge")
      .selectAll("feMergeNode")
      .data(["blur", "SourceGraphic"])
      .join("feMergeNode");

    // ═══════════════════════════════════════════════
    //  Generate spectral-like clusters
    // ═══════════════════════════════════════════════

    const NUM_CLUSTERS = 6;
    const NODES_PER_CLUSTER = 12;
    const TOTAL_NODES = NUM_CLUSTERS * NODES_PER_CLUSTER;

    // Cluster centers spread around the viewport
    const clusterCenters = Array.from({ length: NUM_CLUSTERS }, (_, i) => ({
      x: W * (0.1 + (0.8 * (i % 3)) / 2 + (Math.random() - 0.5) * 0.25),
      y: H * (0.1 + (0.8 * Math.floor(i / 3)) / 1 + (Math.random() - 0.5) * 0.25),
    }));

    // Mutable graph state — nodes and links are reassigned by the
    // topology-evolution interval below.
    let nodes: SpectralNode[] = [];
    let links: SpectralLink[] = [];
    let nextId = TOTAL_NODES; // permanent, unique id source for new nodes

    for (let c = 0; c < NUM_CLUSTERS; c++) {
      for (let n = 0; n < NODES_PER_CLUSTER; n++) {
        nodes.push({
          id: c * NODES_PER_CLUSTER + n,
          group: c,
          // Scatter within cluster
          x: clusterCenters[c].x + (Math.random() - 0.5) * 120,
          y: clusterCenters[c].y + (Math.random() - 0.5) * 120,
          // Vary node size (like spectral intensity)
          r: 1.5 + Math.random() * 3.5,
        });
      }
    }

    // ═══════════════════════════════════════════════
    //  Generate edges
    // ═══════════════════════════════════════════════

    for (let i = 0; i < TOTAL_NODES; i++) {
      for (let j = i + 1; j < TOTAL_NODES; j++) {
        const sameGroup = nodes[i].group === nodes[j].group;
        const prob = sameGroup ? 0.35 : 0.03;
        if (Math.random() < prob) {
          links.push({ source: i, target: j });
        }
      }
    }

    // ═══════════════════════════════════════════════
    //  Force simulation
    // ═══════════════════════════════════════════════

    const linkForce = d3
      .forceLink<SpectralNode, SpectralLink>(links)
      .id((d) => d.id)
      .distance((d) =>
        (d.source as SpectralNode).group === (d.target as SpectralNode).group ? 80 : 250,
      );

    const simulation = d3
      .forceSimulation<SpectralNode>(nodes)
      .force("link", linkForce)
      // Strong repulsion — spreads clusters across the viewport instead of
      // letting the graph collapse into a center ball.
      .force("charge", d3.forceManyBody().strength(-80))
      .force("center", d3.forceCenter(W / 2, H / 2).strength(0.05))
      // Custom tangential force: nudges nodes along circles around the
      // viewport center. Constant (alpha-independent) kick, so the
      // rotation never decays as the simulation cools.
      .force("rotate", () => {
        nodes.forEach((d) => {
          d.vx! += (d.y! - H / 2) * 0.0005;
          d.vy! -= (d.x! - W / 2) * 0.0005;
        });
      })
      .force(
        "collision",
        d3.forceCollide<SpectralNode>().radius((d) => d.r + 4),
      )
      .alphaDecay(0.008) // Slow, gentle settle
      .velocityDecay(0.35) // Smooth dampening
      // Permanent "simmer": alpha decays toward this floor instead of
      // freezing at alphaMin, keeping enough energy for continuous motion.
      .alphaTarget(0.05)
      .stop(); // Halted immediately — we control manually

    // ═══════════════════════════════════════════════
    //  SVG groups + data-join rendering
    // ═══════════════════════════════════════════════

    const linkGroup = svg.append("g").attr("class", "links");
    const nodeGroup = svg.append("g").attr("class", "nodes");

    let link = linkGroup.selectAll<SVGLineElement, SpectralLink>("line");
    let node = nodeGroup.selectAll<SVGCircleElement, SpectralNode>("circle");

    // Stable key so D3 tracks links across topology mutations.
    // Endpoints may be ids (fresh links) or resolved node objects; each
    // pair is wired at most once, so the ordered pair is unique.
    const linkKey = (d: SpectralLink): string => {
      const s = typeof d.source === "object" ? d.source.id : d.source;
      const t = typeof d.target === "object" ? d.target.id : d.target;
      return `${s}-${t}`;
    };

    function renderGraph(): void {
      link = linkGroup
        .selectAll<SVGLineElement, SpectralLink>("line")
        .data(links, linkKey)
        .join(
          (enter) =>
            enter
              .append("line")
              .attr("x1", (d) => (d.source as SpectralNode).x!)
              .attr("y1", (d) => (d.source as SpectralNode).y!)
              .attr("x2", (d) => (d.target as SpectralNode).x!)
              .attr("y2", (d) => (d.target as SpectralNode).y!)
              .attr("stroke", "var(--color-accent, #658594)")
              .attr("stroke-width", 1.0)
              .attr("stroke-opacity", 0)
              .call((sel) => sel.transition().duration(600).attr("stroke-opacity", 0.6)),
          (update) => update,
          (exit) =>
            exit.call((sel) => sel.transition().duration(400).attr("stroke-opacity", 0).remove()),
        );

      node = nodeGroup
        .selectAll<SVGCircleElement, SpectralNode>("circle")
        .data(nodes, (d: SpectralNode) => d.id)
        .join(
          (enter) =>
            enter
              .append("circle")
              .attr("r", (d: SpectralNode) => d.r)
              .attr("cx", (d: SpectralNode) => d.x!)
              .attr("cy", (d: SpectralNode) => d.y!)
              .attr("fill", "var(--color-accent, #658594)")
              .attr("fill-opacity", 0)
              .attr("stroke", "var(--color-accent, #658594)")
              .attr("stroke-width", 0.3)
              .attr("stroke-opacity", 0.5)
              .style("cursor", "crosshair")
              .call((sel) => sel.transition().duration(600).attr("fill-opacity", 0.95)),
          (update) => update,
          (exit) =>
            exit.call((sel) =>
              sel.transition().duration(400).attr("fill-opacity", 0).attr("r", 0).remove(),
            ),
        );

      attachHover(node);
    }

    // ═══════════════════════════════════════════════
    //  Tick handler — positions DOM elements
    // ═══════════════════════════════════════════════

    function tick(): void {
      link
        .attr("x1", (d) => (d.source as SpectralNode).x!)
        .attr("y1", (d) => (d.source as SpectralNode).y!)
        .attr("x2", (d) => (d.target as SpectralNode).x!)
        .attr("y2", (d) => (d.target as SpectralNode).y!);

      node.attr("cx", (d: SpectralNode) => d.x!).attr("cy", (d: SpectralNode) => d.y!);
    }

    simulation.on("tick", tick);

    // ── Render initial state ──
    renderGraph();

    // Run enough ticks off-screen so nodes settle into a natural layout
    // before we decide whether to animate or stay static.
    for (let i = 0; i < 60; i++) simulation.tick();
    tick(); // flush positions to the DOM

    // Start the live animation *unless* the user prefers reduced motion
    if (!prefersReducedMotion) {
      simulation.alpha(0.3).restart();
    }

    updateToggleIcon();

    // ═══════════════════════════════════════════════
    //  Dynamic topology evolution
    //  Every 2.5 s: retire one node, grow one fresh node,
    //  rejoin both selections, and gently reheat the simulation.
    // ═══════════════════════════════════════════════

    function createNode(): SpectralNode {
      const c = Math.floor(Math.random() * NUM_CLUSTERS);

      // Calculate the CURRENT center of mass for this specific cluster,
      // so the graph's rotation isn't anchored to the static spawn points.
      const groupNodes = nodes.filter((n) => n.group === c);
      let cx = W / 2;
      let cy = H / 2;

      if (groupNodes.length > 0) {
        cx = d3.mean(groupNodes, (n) => n.x!) ?? W / 2;
        cy = d3.mean(groupNodes, (n) => n.y!) ?? H / 2;
      }

      return {
        id: nextId++, // unique, strictly increasing (safer than Date.now())
        group: c,
        // Wide offset preserves the kinetic "fragmentation" effect
        // without anchoring the graph's rotation to the origin.
        x: cx + (Math.random() - 0.5) * 450,
        y: cy + (Math.random() - 0.5) * 450,
        r: 1.5 + Math.random() * 3.5,
      };
    }

    // Wire the fresh node to 1–2 random same-group nodes to keep
    // cluster cohesion.
    function connectNode(fresh: SpectralNode): void {
      const sameGroup = nodes.filter((n) => n.id !== fresh.id && n.group === fresh.group);
      const targetCount = Math.min(sameGroup.length, 1 + (Math.random() < 0.5 ? 1 : 0));

      const targets = new Set<number>();
      while (targets.size < targetCount) {
        targets.add(sameGroup[Math.floor(Math.random() * sameGroup.length)].id);
      }

      for (const t of targets) links.push({ source: fresh.id, target: t });
    }

    function mutateGraph(): void {
      // Constraint: never churn while paused (user toggle, reduced motion,
      // off-screen, or backgrounded tab).
      if (effectivePaused()) return;

      // 1. Retire the oldest node unconditionally — shift() always
      //    processes while the array is non-empty, so the churn can
      //    never stall.
      const victim = nodes.shift();
      if (!victim) return; // defensive: nothing to retire

      // … and drop every link attached to it.
      links = links.filter((l) => {
        const s = typeof l.source === "object" ? l.source.id : l.source;
        const t = typeof l.target === "object" ? l.target.id : l.target;
        return s !== victim.id && t !== victim.id;
      });

      // 2. Grow one fresh node, push it into the graph, and wire it up.
      //    The push MUST happen before linkForce re-initializes, otherwise
      //    endpoint resolution hits undefined and crashes the D3 timer.
      const fresh = createNode();
      nodes.push(fresh);
      connectNode(fresh);

      // 3. Rewire the simulation to the mutated arrays, re-render, reheat.
      //    .nodes() re-indexes and re-initializes forces; .links() resolves
      //    the fresh id endpoints to node objects.
      simulation.nodes(nodes);
      linkForce.links(links); // ≡ simulation.force("link").links(links)
      renderGraph();
      // Gentle reheat: 0.015 gives the link force enough pull to guide the
      // new node in without rattling the established structure.
      simulation.alpha(0.015).restart();
    }

    // Perpetual churn loop. d3.interval rides the d3 timer queue (rAF), so
    // it automatically idles in backgrounded tabs; the pause guard above
    // handles reduced-motion, the user toggle, and off-screen states.
    d3.interval(mutateGraph, 2500);

    // ═══════════════════════════════════════════════
    //  Hover interaction — rebound after every data join so
    //  newly entering nodes are interactive immediately.
    // ═══════════════════════════════════════════════

    function attachHover(
      sel: d3.Selection<SVGCircleElement, SpectralNode, SVGGElement, unknown>,
    ): void {
      sel
        .on("mouseenter", function (_event, d) {
          d3.select(this)
            .transition()
            .duration(150)
            .attr("r", d.r * 2.2)
            .attr("fill", "var(--color-accent, #658594)")
            .attr("fill-opacity", 1)
            .attr("stroke", "var(--color-accent, #658594)")
            .attr("stroke-opacity", 0.8)
            .attr("filter", "url(#node-glow)");

          link
            .transition()
            .duration(150)
            .attr("stroke-opacity", (l) => {
              const s = typeof l.source === "object" ? l.source.id : l.source;
              const t = typeof l.target === "object" ? l.target.id : l.target;
              return s === d.id || t === d.id ? 0.85 : 0.03;
            })
            .attr("stroke", (l) => {
              const s = typeof l.source === "object" ? l.source.id : l.source;
              const t = typeof l.target === "object" ? l.target.id : l.target;
              return s === d.id || t === d.id
                ? "var(--color-accent, #658594)"
                : "var(--color-border, #223249)";
            })
            .attr("stroke-width", (l) => {
              const s = typeof l.source === "object" ? l.source.id : l.source;
              const t = typeof l.target === "object" ? l.target.id : l.target;
              return s === d.id || t === d.id ? 1.2 : 0.4;
            });
        })
        .on("mouseleave", function () {
          d3.select(this)
            .transition()
            .duration(400)
            .attr("r", (d) => (d as SpectralNode).r)
            .attr("fill", "var(--color-accent, #658594)")
            .attr("fill-opacity", 0.95)
            .attr("stroke", "var(--color-accent, #658594)")
            .attr("stroke-opacity", 0.5)
            .attr("filter", null);

          link
            .transition()
            .duration(400)
            .attr("stroke", "var(--color-accent, #658594)")
            .attr("stroke-opacity", 0.6)
            .attr("stroke-width", 1.0);
        });
    }

    // ═══════════════════════════════════════════════
    //  Subtle cursor gravity
    // ═══════════════════════════════════════════════

    svg.on("mousemove", function (event) {
      const [mx, my] = d3.pointer(event);
      // Gentle parallax: shift the center of gravity toward the cursor by
      // a small fraction of its offset — never a per-node spring, so the
      // graph can't collapse into a singularity at the pointer.
      const offsetX = (mx - W / 2) * 0.05;
      const offsetY = (my - H / 2) * 0.05;

      // Mutate the existing force's coordinates — recreating d3.forceCenter
      // on every mousemove would force D3 to rebuild its internal node maps
      // ~60×/s, producing garbage-collection stutter.
      const centerForce = simulation.force<d3.ForceCenter<SpectralNode>>("center");
      if (centerForce) {
        centerForce.x(W / 2 + offsetX).y(H / 2 + offsetY);
      }
    });

    // ═══════════════════════════════════════════════
    //  Handle resize
    // ═══════════════════════════════════════════════

    window.addEventListener("resize", () => {
      // Update the shared viewport dimensions so the rotate axis, parallax
      // center, and createNode fallback all track the center force.
      W = window.innerWidth;
      H = window.innerHeight;
      svg.attr("width", W).attr("height", H);

      // Mutate the existing force so its 0.05 strength is preserved —
      // recreating it would snap the strength to the default 1.0 and jerk
      // the whole graph on the next node swap.
      const centerForce = simulation.force<d3.ForceCenter<SpectralNode>>("center");
      if (centerForce) {
        centerForce.x(W / 2).y(H / 2);
      }

      if (!effectivePaused()) {
        simulation.alpha(0.15).restart();
      }
    });

    // ═══════════════════════════════════════════════
    //  Visibility-aware auto-pause (CPU conservation)
    // ═══════════════════════════════════════════════

    // 1. IntersectionObserver — pause when the layer scrolls out of view.
    //    The container fills its (viewport-sized) host wrapper, so
    //    "out of view" means the wrapper has scrolled off-screen.
    const observer = new IntersectionObserver(
      (entries) => {
        outOfView = !entries.some((entry) => entry.isIntersecting);
        applyPauseState();
      },
      { threshold: 0 },
    );
    observer.observe(container);

    // 2. Page Visibility API — pause when the tab is backgrounded
    document.addEventListener("visibilitychange", () => {
      tabHidden = document.hidden;
      applyPauseState();
    });

    // 3. React to system reduced-motion preference changes at runtime
    window.matchMedia("(prefers-reduced-motion: reduce)").addEventListener("change", (e) => {
      userPaused = e.matches;
      applyPauseState();
    });
  }

  // Run on DOM ready
  initSpectralNetwork();
</script>
</file>

